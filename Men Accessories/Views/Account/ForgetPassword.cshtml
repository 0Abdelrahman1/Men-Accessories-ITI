@model ForgetPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- BREADCRUMB -->
<div class="breadcrumb">
    <a asp-controller="Home" asp-action="Index">Home</a>
    <span class="sep">›</span>
    <a asp-action="Login" asp-controller="Account">Sign In</a>
    <span class="sep">›</span>
    <span class="current">Forgot Password</span>
</div>

<!-- AUTH CARD -->
<div class="auth-card">

    <div class="icon-circle purple">
        <svg viewBox="0 0 24 24" fill="none" stroke="#7a6cf0" stroke-width="1.8">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
            <path d="M7 11V7a5 5 0 0110 0v4"/>
        </svg>
    </div>

    <div class="card-eyebrow">Account Recovery</div>
    <div class="card-title">Forgot Password?</div>
    <p class="card-sub">
        No worries! Enter your email address below and we'll send you a link to reset your password.
    </p>

    

    <form asp-action="SendResetPasswordLink" method="post">
        <div asp-validation-summary="All" class="validation-summary-errors" style="margin-bottom:20px;"></div>

        <!-- Email -->
        <div class="form-group">
            <label class="form-label" asp-for="Email">Email Address</label>
            <input asp-for="Email" class="form-control" placeholder="your@email.com" />
            <span asp-validation-for="Email" class="field-validation-error"></span>
        </div>

        <!-- Submit -->
        <button type="submit" class="btn-primary">Send Reset Link</button>

        <!-- Cancel -->
        <a asp-action="Login" asp-controller="Account" class="btn-ghost" 
           style="display:block; text-align:center; margin-top:12px;">
            Back to Sign In
        </a>
    </form>

    <div class="card-footer">
        Don't have an account? <a asp-action="Register" asp-controller="Account">Register Now</a>
    </div>

</div>

@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}