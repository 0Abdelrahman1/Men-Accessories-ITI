@{
    ViewData["Title"] = "Email Confirmed";
    Layout = "~/Views/Shared/_ShopLayout.cshtml";
}

@section Styles {
    <partial name="_AccountAuthStyles" />
}

<div class="auth-page">

    <!-- AUTH CARD -->
    <div class="auth-card" style="text-align:center; margin-top: 20px;">
        <div class="icon-circle green">
            <svg viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
        </div>
        <div class="card-eyebrow">Success</div>
        <div class="card-title">Email Confirmed!</div>
        <p class="card-sub">
            Your account has been successfully verified. You can now sign in and start shopping.
        </p>
        <a asp-action="Login" asp-controller="Account" class="btn-primary" style="text-decoration:none;">
            Go to Sign In
        </a>
    </div>

</div>
