@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
}

<div class="breadcrumb">
    <a asp-controller="Home" asp-action="Index">Home</a>
    <span class="sep">/</span>
    <span class="current">Reset Password</span>
</div>

<div class="auth-card">

    <div class="card-eyebrow">Account Recovery</div>
    <div class="card-title">Reset Password</div>
    <div class="card-sub">
        Enter your new password below to regain access to your account.
    </div>

    <form asp-action="ResetPassword" method="post">

        <div asp-validation-summary="All" class="validation-summary-errors"></div>

        <!-- Password -->
        <div class="form-group">
            <label class="form-label">New Password</label>
            <input asp-for="Password" id="pass1" class="form-control" type="password" placeholder="Enter new password" />
            <span class="eye-toggle" onclick="togglePass('pass1', this)">SHOW</span>
            <span asp-validation-for="Password" class="field-validation-error"></span>
        </div>

        <!-- Confirm Password -->
        <div class="form-group">
            <label class="form-label">Confirm Password</label>
            <input asp-for="ConfirmPassword" id="pass2" class="form-control" type="password" placeholder="Confirm password" />
            <span class="eye-toggle" onclick="togglePass('pass2', this)">SHOW</span>
            <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
        </div>

        <!-- Submit -->
        <button type="submit" class="btn-primary">Change Password</button>

        <!-- Cancel -->
        <a asp-action="Login" class="btn-ghost" style="margin-top:12px; text-align:center;">Cancel</a>

    </form>

</div>