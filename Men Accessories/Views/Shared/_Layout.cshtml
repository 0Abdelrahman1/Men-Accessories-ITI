<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – COZA STORE</title>

    <link href="https://fonts.googleapis.com/css2?family=Josefin+Sans:wght@300;400;600;700&family=Lato:wght@300;400;700&display=swap" rel="stylesheet" />

    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --black:       #111111;
            --white:       #ffffff;
            --gray-light:  #f5f5f5;
            --gray-mid:    #e0e0e0;
            --gray-text:   #999999;
            --accent:      #7a6cf0;
            --accent-dark: #5a4dd4;
            --error:       #e05252;
            --success:     #4caf85;
            --font-display:'Josefin Sans', sans-serif;
            --font-body:   'Lato', sans-serif;
        }

        body { font-family: var(--font-body); background: var(--gray-light); color: var(--black); min-height: 100vh; display: flex; flex-direction: column; }

        /* ?? TOP BAR ?? */
        .topbar {
            background: var(--black); color: var(--white);
            font-family: var(--font-display); font-size: 12px; letter-spacing: 1.5px;
            display: flex; justify-content: space-between; align-items: center;
            padding: 0 48px; height: 36px;
        }
        .topbar-links { display: flex; gap: 28px; }
        .topbar-links a { color: var(--white); text-decoration: none; opacity: .7; transition: opacity .2s; }
        .topbar-links a:hover { opacity: 1; }

        /* ?? NAVBAR ?? */
        .navbar {
            background: var(--white);
            display: flex; align-items: center; justify-content: space-between;
            padding: 0 48px; height: 72px;
            border-bottom: 1px solid var(--gray-mid);
            position: sticky; top: 0; z-index: 200;
            box-shadow: 0 2px 16px rgba(0,0,0,.06);
        }
        .logo { font-family: var(--font-display); font-weight: 700; font-size: 22px; letter-spacing: 4px; text-decoration: none; color: var(--black); }
        .logo span { font-weight: 300; }
        .nav-links { display: flex; gap: 36px; list-style: none; }
        .nav-links a {
            font-family: var(--font-display); font-size: 13px; letter-spacing: 2px;
            text-decoration: none; color: var(--black);
            position: relative; padding-bottom: 4px; transition: color .2s;
        }
        .nav-links a::after { content:''; position:absolute; bottom:0; left:0; width:0; height:2px; background:var(--accent); transition:width .3s; }
        .nav-links a:hover::after, .nav-links a.active::after { width:100%; }
        .nav-links a.active { color: var(--accent); }
        .hot-badge { background:var(--accent); color:var(--white); font-size:9px; letter-spacing:1px; padding:2px 5px; border-radius:3px; vertical-align:super; font-weight:700; }
        .nav-icons { display:flex; gap:18px; align-items:center; }
        .nav-icons svg { width:20px; height:20px; cursor:pointer; opacity:.65; transition:opacity .2s; }
        .nav-icons svg:hover { opacity:1; }

        /* ?? PAGE WRAPPER ?? */
        .page-content { flex: 1; padding: 52px 20px 72px; display: flex; flex-direction: column; align-items: center; }

        /* ?? BREADCRUMB ?? */
        .breadcrumb {
            font-family: var(--font-display); font-size: 11px; letter-spacing: 2.5px;
            color: var(--gray-text); display: flex; gap: 10px; align-items: center;
            margin-bottom: 36px; text-transform: uppercase;
        }
        .breadcrumb a { color: var(--gray-text); text-decoration: none; }
        .breadcrumb a:hover { color: var(--accent); }
        .breadcrumb .sep { color: var(--gray-mid); }
        .breadcrumb .current { color: var(--accent); }

        /* ?? AUTH CARD ?? */
        .auth-card {
            background: var(--white);
            width: 100%; max-width: 460px;
            padding: 52px 48px 56px;
            box-shadow: 0 8px 48px rgba(0,0,0,.08);
            animation: fadeUp .45s ease both;
        }
        .auth-card.wide { max-width: 540px; }

        @@keyframes fadeUp {
            from { opacity:0; transform:translateY(24px); }
            to   { opacity:1; transform:translateY(0); }
        }

        .card-eyebrow { font-family:var(--font-display); font-size:11px; letter-spacing:3px; color:var(--accent); margin-bottom:10px; font-weight:600; }
        .card-title   { font-family:var(--font-display); font-size:30px; font-weight:700; letter-spacing:3px; text-transform:uppercase; margin-bottom:8px; }
        .card-sub     { font-size:14px; color:var(--gray-text); line-height:1.65; margin-bottom:38px; }

        /* ?? FORM ELEMENTS ?? */
        .form-group   { margin-bottom: 22px; position: relative; }
        .form-label   { display:block; font-family:var(--font-display); font-size:11px; letter-spacing:2px; font-weight:600; margin-bottom:8px; }
        .form-control {
            width: 100%; border: 1.5px solid var(--gray-mid);
            padding: 13px 16px; font-family:var(--font-body); font-size:14px;
            color: var(--black); background: var(--gray-light); outline: none;
            transition: border-color .25s, background .25s; -webkit-appearance: none; border-radius: 0;
        }
        .form-control:focus { border-color: var(--accent); background: var(--white); }
        .form-control::placeholder { color: #bbb; }
        .form-control.input-error { border-color: var(--error); }

        .field-validation-error { font-size:12px; color:var(--error); margin-top:5px; display:block; }
        .validation-summary-errors ul { list-style:none; }
        .validation-summary-errors li { font-size:13px; color:var(--error); margin-bottom:4px; }
        .validation-summary-valid { display:none; }

        .eye-toggle { position:absolute; right:14px; top:37px; cursor:pointer; color:var(--gray-text); font-size:11px; font-family:var(--font-display); letter-spacing:1px; user-select:none; font-weight:600; }
        .eye-toggle:hover { color:var(--accent); }

        /* ?? PASSWORD STRENGTH ?? */
        .strength-bar { display:flex; gap:4px; margin-top:8px; }
        .strength-seg { height:3px; flex:1; background:var(--gray-mid); border-radius:2px; transition:background .3s; }
        .strength-seg.weak   { background:var(--error); }
        .strength-seg.medium { background:#f5a623; }
        .strength-seg.strong { background:var(--success); }
        .strength-label { font-size:11px; color:var(--gray-text); margin-top:5px; font-family:var(--font-display); letter-spacing:1px; }

        /* ?? CHECKBOX ?? */
        .check-row { display:flex; align-items:flex-start; gap:10px; margin-bottom:26px; }
        .check-row input[type=checkbox] { width:16px; height:16px; accent-color:var(--accent); cursor:pointer; flex-shrink:0; margin-top:2px; }
        .check-row label { font-size:13px; color:var(--gray-text); cursor:pointer; line-height:1.5; }
        .check-row a { color:var(--accent); text-decoration:none; }

        /* ?? FORGOT LINK ?? */
        .forgot-link { font-size:12px; color:var(--gray-text); text-decoration:none; display:block; text-align:right; margin-top:-10px; margin-bottom:24px; letter-spacing:.5px; font-family:var(--font-display); }
        .forgot-link:hover { color:var(--accent); }

        /* ?? BUTTONS ?? */
        .btn-primary {
            display:block; width:100%; background:var(--black); color:var(--white);
            font-family:var(--font-display); font-size:12px; letter-spacing:3px; font-weight:700;
            padding:16px; border:2px solid var(--black); cursor:pointer; text-transform:uppercase;
            transition:background .25s, color .25s; text-align:center; text-decoration:none;
        }
        .btn-primary:hover { background:var(--white); color:var(--black); }
        .btn-accent {
            display:block; width:100%; background:var(--accent); color:var(--white);
            font-family:var(--font-display); font-size:12px; letter-spacing:3px; font-weight:700;
            padding:16px; border:2px solid var(--accent); cursor:pointer; text-transform:uppercase;
            transition:background .25s, border-color .25s; margin-top:10px; text-align:center; text-decoration:none;
        }
        .btn-accent:hover { background:var(--accent-dark); border-color:var(--accent-dark); }
        .btn-ghost {
            display:inline-block; background:transparent; color:var(--black);
            font-family:var(--font-display); font-size:12px; letter-spacing:2.5px; font-weight:600;
            padding:14px 28px; border:1.5px solid var(--gray-mid); cursor:pointer; text-transform:uppercase;
            transition:border-color .25s, color .25s; text-decoration:none;
        }
        .btn-ghost:hover { border-color:var(--black); }

        /* ?? DIVIDER ?? */
        .or-divider { display:flex; align-items:center; gap:14px; margin:28px 0; color:var(--gray-text); font-size:11px; letter-spacing:2px; font-family:var(--font-display); }
        .or-divider::before, .or-divider::after { content:''; flex:1; height:1px; background:var(--gray-mid); }

        /* ?? SOCIAL ?? */
        .social-row { display:flex; gap:12px; }
        .btn-social {
            flex:1; display:flex; align-items:center; justify-content:center; gap:8px;
            padding:12px; border:1.5px solid var(--gray-mid); background:var(--white);
            font-family:var(--font-display); font-size:11px; letter-spacing:1.5px;
            cursor:pointer; transition:border-color .25s; color:var(--black); font-weight:600;
        }
        .btn-social:hover { border-color:var(--accent); color:var(--accent); }

        /* ?? CARD FOOTER ?? */
        .card-footer { margin-top:30px; text-align:center; font-size:13.5px; color:var(--gray-text); }
        .card-footer a { color:var(--accent); text-decoration:none; font-weight:600; }
        .card-footer a:hover { text-decoration:underline; }

        /* ?? ICON CIRCLE ?? */
        .icon-circle { width:76px; height:76px; border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 30px; }
        .icon-circle.purple { background:#f0eeff; }
        .icon-circle.green  { background:#eef9f3; }
        .icon-circle svg { width:36px; height:36px; }

        /* ?? INFO BOX ?? */
        .info-box { background:var(--gray-light); border-left:3px solid var(--accent); padding:14px 18px; font-size:13.5px; color:var(--gray-text); line-height:1.65; margin-bottom:30px; }
        .info-box strong { color:var(--black); }

        /* ?? OTP ?? */
        .otp-row { display:flex; gap:12px; justify-content:center; margin-bottom:30px; }
        .otp-input {
            width:56px; height:60px; border:1.5px solid var(--gray-mid);
            text-align:center; font-family:var(--font-display); font-size:24px; font-weight:700;
            color:var(--black); background:var(--gray-light); outline:none; transition:border-color .25s; border-radius:0;
        }
        .otp-input:focus { border-color:var(--accent); background:var(--white); }

        .resend-row { text-align:center; font-size:13px; color:var(--gray-text); margin-bottom:24px; }
        .resend-row a { color:var(--accent); cursor:pointer; text-decoration:none; font-weight:600; }

        /* ?? STEP DOTS ?? */
        .step-dots { display:flex; justify-content:center; gap:8px; margin-bottom:34px; }
        .step-dot { width:8px; height:8px; border-radius:50%; background:var(--gray-mid); }
        .step-dot.done   { background:var(--success); }
        .step-dot.active { background:var(--accent); }

        /* ?? REQUIREMENTS ?? */
        .req-list { margin:10px 0 24px; padding:0; list-style:none; }
        .req-list li { font-size:12.5px; color:var(--gray-text); padding:3px 0; display:flex; align-items:center; gap:8px; }
        .req-list li .req-icon { font-size:11px; }
        .req-list li.met { color:var(--success); }

        /* ?? TWO-COL GRID ?? */
        .grid-2 { display:grid; grid-template-columns:1fr 1fr; gap:16px; }

        /* ?? FOOTER ?? */
        .site-footer { background:var(--black); color:var(--gray-text); text-align:center; padding:26px 20px; font-family:var(--font-display); font-size:11px; letter-spacing:2px; }
        .site-footer a { color:var(--gray-text); text-decoration:none; margin:0 12px; }
        .site-footer a:hover { color:var(--white); }

        @@media (max-width:540px) {
            .navbar, .topbar { padding:0 20px; }
            .nav-links { display:none; }
            .auth-card { padding:36px 24px 44px; }
            .card-title { font-size:24px; }
            .otp-input  { width:42px; height:48px; font-size:20px; }
            .social-row { flex-direction:column; }
            .grid-2     { grid-template-columns:1fr; }
        }
    </style>

    @RenderSection("Styles", required: false)
</head>
<body>

    <!-- TOP BAR -->
    <div class="topbar">
        <span>Free shipping for standard order over $100</span>
        <div class="topbar-links">
    <a href="#">Help &amp; FAQs</a>

    @if (User.Identity.IsAuthenticated)
    {
        <a asp-controller="Order" asp-action="MyOrders" style="color: var(--accent); font-weight: bold;">My Orders</a>
        
        <span>Hello, @User.Identity.Name</span>

        <form asp-controller="Account" asp-action="Logout" method="Get" style="display:inline;">
            <button type="submit" style="background:none;border:none;color:inherit;cursor:pointer;">
                Logout
            </button>
        </form>
    }
    else
    {
        <a asp-controller="Account" asp-action="Register">Register</a>
        <a asp-controller="Account" asp-action="Login">Login</a>
    }
</div>
    </div>

    <!-- NAVBAR -->
    <nav class="navbar">
        <a class="logo" asp-controller="Home" asp-action="Index"><strong>COZA</strong> <span>STORE</span></a>
        <ul class="nav-links">
            <li><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li><a href="#">Shop</a></li>
            <li><a href="#">Features <span class="hot-badge">HOT</span></a></li>
            <li><a href="#">Blog</a></li>
            <li>
                <a asp-controller="Home" asp-action="About">
                    About
                </a>
            </li>

            <li>
                <a asp-controller="Home" asp-action="Contact">
                    Contact
                </a>
            </li>
          @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
            {
                <li>
                    <a asp-controller="Admin" asp-action="Index" style="color: var(--error); font-weight: bold;">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 14px; height: 14px; margin-right: 4px; vertical-align: text-top;"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="9" y1="21" x2="9" y2="9"></line></svg>
                        C-PANEL
                    </a>
                </li>
            }
        </ul>
       <div class="nav-icons">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
            
            <a asp-controller="Cart" asp-action="Index" style="color: inherit; text-decoration: none; display: flex; align-items: center;">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
            </a>
            
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>
        </div>
    </nav>

    <!-- PAGE CONTENT -->
    <div class="page-content">
        @RenderBody()
    </div>

    <!-- FOOTER -->
    <footer class="site-footer">
        <div>
            <a href="#">Privacy Policy</a>
            <a href="#">Terms of Service</a>
            <a href="#">Help &amp; FAQs</a>
            <a href="#">Contact Us</a>
        </div>
        <div style="margin-top:12px;">&copy; @DateTime.Now.Year COZA STORE. All rights reserved.</div>
    </footer>

    <script>
        function togglePass(inputId, btn) {
            var inp = document.getElementById(inputId);
            if (inp.type === 'password') { inp.type = 'text'; btn.textContent = 'HIDE'; }
            else { inp.type = 'password'; btn.textContent = 'SHOW'; }
        }
        function otpJump(el, next) {
            if (el.value.length === 1 && next) { document.getElementById(next).focus(); }
        }
    </script>
   <script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    @RenderSection("Scripts", required: false)
    
</body>
</html>
