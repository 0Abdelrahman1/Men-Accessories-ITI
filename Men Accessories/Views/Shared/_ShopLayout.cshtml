<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – COZA STORE</title>

    <link href="https://fonts.googleapis.com/css2?family=Josefin+Sans:wght@300;400;600;700&family=Lato:wght@300;400;700&display=swap" rel="stylesheet" />

    <style>
        /* =========================================
           1. RESET & VARIABLES
        ========================================= */
        *, *::before, *::after { 
            box-sizing: border-box; 
            margin: 0; 
            padding: 0; 
        }

        :root {
            /* Modern Luxury Color Palette */
            --primary-dark: #0F172A;   /* Slate 900 */
            --primary-text: #334155;   /* Slate 700 */
            --gray-light:   #F8FAFC;   /* Slate 50 */
            --gray-mid:     #E2E8F0;   /* Slate 200 */
            --white:        #FFFFFF;
            
            /* Vibrant Accent (Indigo) */
            --accent:       #4F46E5;   
            --accent-hover: #4338CA;
            
            /* Status Colors */
            --error:        #EF4444;   /* Red 500 */
            --success:      #10B981;   /* Emerald 500 */
            --warning:      #F59E0B;   /* Amber 500 */

            /* Typography */
            --font-display: 'Josefin Sans', sans-serif;
            --font-body:    'Lato', sans-serif;

            /* Effects */
            --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
            --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
            --transition: all 0.3s ease-in-out;
        }

        body { 
            font-family: var(--font-body); 
            background-color: var(--gray-light); 
            color: var(--primary-text); 
            min-height: 100vh; 
            display: flex; 
            flex-direction: column; 
            -webkit-font-smoothing: antialiased;
        }

        /* =========================================
           2. TOP BAR
        ========================================= */
        .topbar {
            background-color: var(--primary-dark);
            color: var(--gray-mid);
            font-family: var(--font-display); 
            font-size: 12px; 
            letter-spacing: 1.5px;
            display: flex; 
            justify-content: space-between; 
            align-items: center;
            padding: 0 5%; 
            height: 40px;
        }
        
        .topbar-msg {
            text-transform: uppercase;
            font-weight: 600;
        }

        .topbar-links { 
            display: flex; 
            gap: 24px; 
            align-items: center;
        }

        .topbar-links a, .topbar-links button { 
            color: var(--gray-mid); 
            text-decoration: none; 
            transition: var(--transition);
            background: none;
            border: none;
            font-family: inherit;
            font-size: inherit;
            letter-spacing: inherit;
            cursor: pointer;
            text-transform: uppercase;
        }

        .topbar-links a:hover, .topbar-links button:hover { 
            color: var(--white); 
        }

        .user-greeting {
            color: var(--white);
            font-weight: 700;
        }

        /* =========================================
           3. NAVBAR
        ========================================= */
        .navbar {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            display: flex; 
            align-items: center; 
            justify-content: space-between;
            padding: 0 5%; 
            height: 80px;
            position: sticky; 
            top: 0; 
            z-index: 1000;
            box-shadow: var(--shadow-sm);
            transition: var(--transition);
        }

        .navbar:hover {
            box-shadow: var(--shadow-md);
        }

        .logo { 
            font-family: var(--font-display); 
            font-weight: 700; 
            font-size: 26px; 
            letter-spacing: 3px; 
            text-decoration: none; 
            color: var(--primary-dark);
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .logo span { 
            font-weight: 300;
            color: var(--accent);
        }

        .nav-links { 
            display: flex; 
            gap: 40px; 
            list-style: none;
            align-items: center;
        }

        .nav-links a {
            font-family: var(--font-display); 
            font-size: 14px; 
            letter-spacing: 1.5px;
            font-weight: 600;
            text-transform: uppercase;
            text-decoration: none; 
            color: var(--primary-dark);
            position: relative; 
            padding: 8px 0; 
            transition: var(--transition);
        }

        /* Animated Underline Effect */
        .nav-links a::after { 
            content: ''; 
            position: absolute; 
            bottom: 0; 
            left: 0; 
            width: 0; 
            height: 2px; 
            background: var(--accent); 
            transition: width 0.3s ease;
        }

        .nav-links a:hover::after, .nav-links a.active::after { 
            width: 100%; 
        }
        
        .nav-links a:hover, .nav-links a.active { 
            color: var(--accent); 
        }

        .hot-badge { 
            background: var(--warning); 
            color: var(--white); 
            font-size: 9px; 
            letter-spacing: 1px; 
            padding: 2px 6px; 
            border-radius: 12px; 
            position: absolute;
            top: -10px;
            right: -20px;
            font-weight: 700; 
        }

        .admin-link {
            color: var(--error) !important;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .admin-link::after { background: var(--error) !important; }

        .nav-icons { 
            display: flex; 
            gap: 20px; 
            align-items: center; 
        }

        .icon-btn {
            color: var(--primary-dark);
            text-decoration: none;
            position: relative;
            transition: var(--transition);
            display: flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: transparent;
        }

        .icon-btn:hover { 
            color: var(--accent);
            background: var(--gray-light);
            transform: translateY(-2px);
        }

        .icon-btn svg { 
            width: 22px; 
            height: 22px; 
        }

        /* =========================================
           4. PAGE CONTENT WRAPPER
        ========================================= */
        .page-content { 
            flex: 1; 
            padding: 60px 5%; 
            display: flex; 
            flex-direction: column; 
            align-items: center; 
            width: 100%;
            max-width: 1400px;
            margin: 0 auto;
        }

        /* =========================================
           5. FOOTER
        ========================================= */
        .site-footer { 
            background: var(--primary-dark); 
            color: var(--gray-mid); 
            text-align: center; 
            padding: 40px 20px; 
            font-family: var(--font-display); 
            font-size: 13px; 
            letter-spacing: 1.5px;
            margin-top: auto;
        }

        .footer-links {
            margin-bottom: 20px;
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 24px;
        }

        .site-footer a { 
            color: var(--gray-mid); 
            text-decoration: none; 
            transition: var(--transition);
            text-transform: uppercase;
        }

        .site-footer a:hover { 
            color: var(--white); 
        }

        .copyright {
            opacity: 0.7;
            font-size: 12px;
        }

        /* =========================================
           6. RESPONSIVE DESIGN
        ========================================= */
        @@media (max-width: 768px) {
            .navbar, .topbar { padding: 0 20px; }
            .nav-links { display: none; /* Can be replaced with a hamburger menu later */ }
            .topbar { flex-direction: column; height: auto; padding: 10px 20px; gap: 10px; text-align: center; }
            .logo { font-size: 22px; }
            .page-content { padding: 40px 20px; }
        }

        /* Search align fix */
        .search-form { display: flex; align-items: center; }
        .search-box {
            display: flex; align-items: center;
            border: 1px solid var(--gray-mid);
            border-radius: 25px; overflow: hidden;
            background: var(--white); height: 40px;
            transition: var(--transition);
        }
        .search-box:hover, .search-box:focus-within { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1); }
        .search-input { border: none; outline: none; padding: 8px 16px; font-size: 14px; width: 220px; font-family: var(--font-body); }
        .search-btn { border: none; background: transparent; cursor: pointer; padding: 0 16px; color: var(--primary-text); transition: var(--transition); }
        .search-btn:hover { color: var(--accent); }
    </style>

    @RenderSection("Styles", required: false)
</head>
<body>

    <div class="topbar">
        <span class="topbar-msg">Free shipping for standard orders over $100</span>
        <div class="topbar-links">
            @if (User.Identity.IsAuthenticated)
            {
                <span class="user-greeting">Hello, @User.Identity.Name</span>
                <a asp-controller="Order" asp-action="MyOrders" style="color: var(--accent); font-weight: bold;">My Orders</a>
                <form asp-controller="Account" asp-action="Logout" method="Get" style="display:inline;">
                    <button type="submit">Logout</button>
                </form>
            }
            else
            {
                <a asp-controller="Account" asp-action="Register">Register</a>
                <a asp-controller="Account" asp-action="Login">Login</a>
            }
        </div>
    </div>

    <nav class="navbar">
        <a class="logo" asp-controller="Home" asp-action="Index">
            <strong>COZA</strong> <span>STORE</span>
        </a>
        
        <ul class="nav-links">
            <li><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li><a href="#">Shop</a></li>
            <li style="position: relative;"><a asp-controller="Home" asp-action="Features">Features <span class="hot-badge">HOT</span></a></li>
            <li><a href="#">Blog</a></li>
            <li><a asp-controller="Home" asp-action="About">About</a></li>
            <li><a asp-controller="Home" asp-action="Contact">Contact</a></li>
            
            @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
            {
                <li>
                    <a asp-controller="Admin" asp-action="Index" class="admin-link">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 16px; height: 16px;">
                            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                            <line x1="3" y1="9" x2="21" y2="9"></line>
                            <line x1="9" y1="21" x2="9" y2="9"></line>
                        </svg>
                        C-PANEL
                    </a>
                </li>
            }
        </ul>

        <div class="nav-icons">
            <a asp-controller="Cart" asp-action="Index" class="icon-btn" title="Shopping Cart">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                    <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
                    <line x1="3" y1="6" x2="21" y2="6"/>
                    <path d="M16 10a4 4 0 01-8 0"/>
                </svg>
            </a>
            
            <a asp-controller="Favorites" asp-action="Index" class="icon-btn" title="My Favorites">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                    <path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/>
                </svg>
            </a>
        </div>
    </nav>

    <main class="page-content">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="footer-links">
            <a href="#">Privacy Policy</a>
            <a href="#">Terms of Service</a>
            <a href="#">Help &amp; FAQs</a>
            <a asp-controller="Home" asp-action="Contact">Contact Us</a>
        </div>
        <div class="copyright">&copy; @DateTime.Now.Year COZA STORE. All rights reserved. Crafted with precision.</div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.20.0/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    <script>
        // Global Utility Scripts
        function togglePass(inputId, btn) {
            var inp = document.getElementById(inputId);
            if (inp.type === 'password') { 
                inp.type = 'text';
                btn.textContent = 'HIDE'; 
            } else { 
                inp.type = 'password';
                btn.textContent = 'SHOW'; 
            }
        }
        
        function otpJump(el, next) {
            if (el.value.length === 1 && next) { 
                document.getElementById(next).focus();
            }
        }
    </script>
    
    @RenderSection("Scripts", required: false)
    
</body>
</html>