@model Men_Accessories.ViewModels.CartRelated.CartModelView

@{
    ViewData["Title"] = "Shopping Cart";
    Layout = "~/Views/Shared/_ShopLayout.cshtml";
}

@section Styles {
    <style>
        .cart-page-container {
            max-width: 1400px;
            margin: 0 auto;
            width: 100%;
            padding: 40px 20px 80px;
            animation: fadeUp 0.5s ease both;
        }

        /* =========================================
           HEADER
        ========================================= */
        .cart-header {
            font-family: var(--font-display);
            font-size: 36px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--primary-dark);
            margin-bottom: 40px;
        }

        /* =========================================
           LAYOUT GRID (TABLE + SUMMARY)
        ========================================= */
        .cart-layout {
            display: grid;
            grid-template-columns: 1fr 380px;
            gap: 40px;
            align-items: start;
        }

        /* =========================================
           CART TABLE
        ========================================= */
        .cart-table-wrapper {
            background: var(--white);
            border-radius: 16px;
            box-shadow: var(--shadow-sm);
            border: 1px solid var(--gray-light);
            overflow: hidden;
        }

        .cart-table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
        }

        .cart-table th {
            background: var(--gray-light);
            font-family: var(--font-display);
            font-size: 13px;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            padding: 20px 24px;
            border-bottom: 1px solid var(--gray-mid);
            color: var(--primary-dark);
            font-weight: 700;
        }

        .cart-table td {
            padding: 24px;
            border-bottom: 1px solid var(--gray-mid);
            vertical-align: middle;
            color: var(--primary-text);
        }

        .cart-table tr:last-child td {
            border-bottom: none;
        }

        .product-col {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .product-col img {
            width: 80px;
            height: 80px;
            object-fit: cover;
            border-radius: 12px;
            border: 1px solid var(--gray-mid);
            box-shadow: var(--shadow-sm);
        }

        .product-col span {
            font-weight: 700;
            font-family: var(--font-display);
            font-size: 16px;
            color: var(--primary-dark);
        }

        /* =========================================
           QUANTITY SELECTOR
        ========================================= */
        .qty-selector {
            display: flex;
            align-items: center;
            border: 1.5px solid var(--gray-mid);
            width: fit-content;
            border-radius: 8px;
            overflow: hidden;
            background: var(--white);
        }

        .qty-btn {
            width: 36px;
            height: 36px;
            background: var(--gray-light);
            border: none;
            cursor: pointer;
            font-size: 18px;
            color: var(--primary-dark);
            transition: var(--transition);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .qty-btn:hover {
            background: var(--gray-mid);
            color: var(--accent);
        }

        .qty-input {
            width: 44px;
            height: 36px;
            text-align: center;
            border: none;
            border-left: 1.5px solid var(--gray-mid);
            border-right: 1.5px solid var(--gray-mid);
            font-weight: 700;
            font-family: var(--font-body);
            color: var(--primary-dark);
            outline: none;
            background: var(--white);
        }

        /* =========================================
           REMOVE BUTTON
        ========================================= */
        .btn-remove {
            background: rgba(239, 68, 68, 0.1);
            border: none;
            color: var(--error);
            cursor: pointer;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: 700;
            padding: 8px 16px;
            border-radius: 6px;
            transition: var(--transition);
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .btn-remove:hover {
            background: var(--error);
            color: var(--white);
            box-shadow: var(--shadow-sm);
        }

        /* =========================================
           CART TOTALS (SUMMARY)
        ========================================= */
        .cart-summary {
            background: var(--white);
            padding: 32px;
            border-radius: 16px;
            box-shadow: var(--shadow-md);
            border: 1px solid var(--gray-light);
            position: sticky;
            top: 100px; /* Sticks when scrolling */
        }

        .summary-title {
            font-family: var(--font-display);
            font-size: 18px;
            letter-spacing: 2px;
            text-transform: uppercase;
            margin-bottom: 24px;
            color: var(--primary-dark);
            font-weight: 700;
            padding-bottom: 16px;
            border-bottom: 1px solid var(--gray-mid);
        }

        .summary-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 16px;
            font-size: 15px;
            color: var(--primary-text);
        }

        .summary-row.final {
            font-family: var(--font-display);
            font-size: 24px;
            font-weight: 700;
            border-top: 2px dashed var(--gray-mid);
            padding-top: 24px;
            margin-top: 8px;
            color: var(--primary-dark);
        }

        .btn-checkout {
            display: block;
            width: 100%;
            background: var(--primary-dark);
            color: var(--white);
            font-family: var(--font-display);
            font-size: 14px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            padding: 18px;
            text-align: center;
            border: none;
            border-radius: 8px;
            transition: var(--transition);
            margin-top: 32px;
            cursor: pointer;
        }

        .btn-checkout:hover {
            background: var(--accent);
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
        }

        /* =========================================
           EMPTY CART
        ========================================= */
        .empty-cart {
            text-align: center;
            padding: 80px 20px;
            border: 2px dashed var(--gray-mid);
            background: var(--white);
            border-radius: 16px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .empty-cart-icon {
            width: 80px;
            height: 80px;
            background: var(--gray-light);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 24px;
            color: var(--gray-text);
        }

        @@keyframes fadeUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @@media (max-width: 992px) {
            .cart-layout { grid-template-columns: 1fr; }
            .cart-summary { position: static; }
        }
        
        @@media (max-width: 768px) {
            .cart-table th:nth-child(2), .cart-table td:nth-child(2) { display: none; } /* Hide Unit Price on mobile to save space */
        }
    </style>
}

<div class="cart-page-container">
    <h1 class="cart-header">Your Cart</h1>

    @if (Model != null && Model.CartItems.Any())
    {
        <div class="cart-layout">
            
            <div class="cart-table-wrapper">
                <table class="cart-table">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Price</th>
                            <th>Quantity</th>
                            <th>Total</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.CartItems)
                        {
                            <tr>
                                <td>
                                    <div class="product-col">
                                        <img src="@item.Product?.ImageUrl" alt="@item.Product?.Name" onerror="this.src='/images/placeholder.jpg'" />
                                        <span>@item.Product?.Name</span>
                                    </div>
                                </td>
                                <td style="font-weight: 600;">$@item.UnitPrice</td>
                                <td>
                                    <div class="qty-selector">
                                        <button type="button" class="qty-btn" onclick="updateQty(@item.ProductId, -1)">-</button>
                                        <input type="text" id="qty-@item.ProductId" class="qty-input" value="@item.Quantity" max="@(item.Product?.StockQuantity ?? 0)" readonly />
                                        <button type="button" class="qty-btn" onclick="updateQty(@item.ProductId, 1)">+</button>
                                    </div>
                                </td>
                                <td id="item-total-@item.ProductId" style="font-weight: 700; color: var(--primary-dark);">
                                    $@(item.UnitPrice * item.Quantity)
                                </td>
                                <td>
                                    <form asp-controller="Cart" asp-action="RemoveFromCart" method="post">
                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                        <button type="submit" class="btn-remove">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14">
                                                <line x1="18" y1="6" x2="6" y2="18"></line>
                                                <line x1="6" y1="6" x2="18" y2="18"></line>
                                            </svg>
                                            Remove
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="cart-summary">
                <h3 class="summary-title">Order Summary</h3>
                
                <div class="summary-row">
                    <span>Subtotal</span>
                    <span>$@Model.CartItems.Sum(i => i.UnitPrice * i.Quantity).ToString("0.00")</span>
                </div>
                
                <div class="summary-row">
                    <span>Shipping</span>
                    <span style="color: var(--success); font-weight: 600;">Calculated at checkout</span>
                </div>

                <div class="summary-row final">
                    <span>Total</span>
                    <span id="cart-grand-total">$@Model.CartItems.Sum(i => i.UnitPrice * i.Quantity).ToString("0.00")</span>
                </div>

                <form asp-controller="Cart" asp-action="Checkout" method="post">
                    <button type="submit" class="btn-checkout">Proceed to Checkout</button>
                </form>
            </div>

        </div>
    }
    else
    {
        <div class="empty-cart">
            <div class="empty-cart-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="40" height="40">
                    <circle cx="9" cy="21" r="1"></circle>
                    <circle cx="20" cy="21" r="1"></circle>
                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                </svg>
            </div>
            <h2 style="font-family: var(--font-display); letter-spacing: 2px; margin-bottom: 12px; color: var(--primary-dark);">Your cart is empty</h2>
            <p style="color: var(--primary-text); margin-bottom: 32px;">Looks like you haven't added anything to your cart yet.</p>
            <a asp-controller="Home" asp-action="Index" class="btn-checkout" style="max-width: 240px; margin: 0; display: inline-block;">Return to Shop</a>
        </div>
    }
</div>

@section Scripts {
    <script>
        function updateQty(productId, change) {
            var input = document.getElementById('qty-' + productId);
            var currentQty = parseInt(input.value);
            var maxStock = parseInt(input.getAttribute('max'));
            var newQty = currentQty + change; 
            
            if (newQty > maxStock) {
                alert("The maximum quantity in stock is " + maxStock);
                return; 
            }    

            if (newQty < 1) return;

            input.value = newQty;

            var formData = new FormData();
            formData.append('productId', productId);
            formData.append('newQuantity', newQty);

            fetch('/Cart/UpdateQuantityAjax', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    document.getElementById('item-total-' + productId).innerText = '$' + data.itemTotal.toFixed(2);
                    
                    var grandTotalEl = document.getElementById('cart-grand-total');
                    if (grandTotalEl) {
                        grandTotalEl.innerText = '$' + data.cartTotal.toFixed(2);
                    }
                }
            });
        }
    </script>
}