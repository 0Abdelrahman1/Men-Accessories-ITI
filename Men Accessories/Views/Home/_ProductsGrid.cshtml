@model List<Product>

<div class="products-grid">
    @foreach (var product in Model)
    {
        <div class="product-card">
            <div class="product-img-wrapper">
                <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id">
                    <img src="@product.ImageUrl" alt="@product.Name" onerror="this.src='/images/placeholder.jpg'" />
                </a>
                
                @if (product.Discount > 0)
                {
                    <span class="discount-badge">-@product.Discount%</span>
                }
            </div>

            <div class="product-details">
                <span class="product-category">@(product.Category?.Name ?? "General")</span>
                
                <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id" class="product-name">
                    @product.Name
                </a>

                <div class="product-meta">
                    <div style="display: flex; align-items: center; gap: 12px;">
                        @{
                            decimal finalPrice = product.Price;
                            decimal oldPrice = 0;
                            if (product.Discount > 0)
                            {
                                finalPrice = product.Price - (product.Price * (product.Discount / 100));
                                oldPrice = product.Price;
                            }
                        }
                        <span class="product-price" style="font-size: 20px;">$@finalPrice.ToString("0.00")</span>
                        @if (oldPrice > 0)
                        {
                            <span class="price-old">$@oldPrice.ToString("0.00")</span>
                        }
                    </div>
                    <span class="product-stock">Stock: <span>@product.StockQuantity</span></span>
                </div>

                <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id" class="btn-ghost btn-card">
                    View Details
                </a>
            </div>
        </div>
    }
</div>