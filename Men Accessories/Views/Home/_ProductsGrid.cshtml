@model List<Product>

@{
    var favoriteIds = ViewBag.FavoriteProductIds as List<int> ?? new List<int>();
}

<div class="products-grid">
    @foreach (var product in Model)
    {
        bool isFav = favoriteIds.Contains(product.Id);

        <div class="product-card">
            <div class="product-img-wrapper">
                <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id">
                    <img src="@product.ImageUrl" alt="@product.Name" onerror="this.src='/images/placeholder.jpg'" />
                </a>
                
                @if (product.Discount > 0)
                {
                    <span class="discount-badge">-@product.Discount.ToString("0")%</span>
                }

                <button type="button" class="btn-favorite" onclick="toggleFavorite(@product.Id, this)" title="@(isFav ? "Remove from Favorites" : "Add to Favorites")">
                    <svg viewBox="0 0 24 24"
                         fill="@(isFav ? "var(--error)" : "none")"
                         stroke="@(isFav ? "var(--error)" : "currentColor")"
                         stroke-width="1.8">
                        <path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z" />
                    </svg>
                </button>
            </div>

            <div class="product-details">
                <span class="product-category">@(product.Category?.Name ?? "General")</span>
                
                <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id" class="product-name">
                    @product.Name
                </a>

                <div class="product-meta">
                    <div style="display: flex; align-items: center; gap: 8px;">
                        @{
                            decimal finalPrice = product.Price;
                            decimal oldPrice = 0;
                            if (product.Discount > 0)
                            {
                                finalPrice = product.Price - (product.Price * (product.Discount / 100));
                                oldPrice = product.Price;
                            }
                        }
                        <span class="product-price">$@finalPrice.ToString("0.00")</span>
                        @if (oldPrice > 0)
                        {
                            <span class="price-old">$@oldPrice.ToString("0.00")</span>
                        }
                    </div>
                    
                    <span class="product-stock">
                        @if (product.StockQuantity > 0)
                        {
                            <span>In Stock</span>
                        }
                        else
                        {
                            <span style="color: var(--error);">Out of Stock</span>
                        }
                    </span>
                </div>

                <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id" class="btn-card">
                    View Details
                </a>
            </div>
        </div>
    }
</div>

