@{
    ViewData["Title"] = "Contact";
}

<div class="breadcrumb">
    <a asp-controller="Home" asp-action="Index">Home</a>
    <span class="sep">/</span>
    <span class="current">Contact</span>
</div>

<section style="width:100%; max-width:1200px;">

    <div style="
        display:grid;
        grid-template-columns:1fr 1fr;
        gap:50px;">

        <!-- FORM -->
        <div class="auth-card wide">

            <div class="card-eyebrow">
                GET IN TOUCH
            </div>

            <h1 class="card-title">
                Contact Us
            </h1>

            <p class="card-sub">
                We'd love to hear from you.
            </p>

            <form>

                <div class="form-group">
                    <label class="form-label">FULL NAME</label>
                    <input class="form-control" type="text" placeholder="Your Name">
                </div>

                <div class="form-group">
                    <label class="form-label">EMAIL</label>
                    <input class="form-control" type="email" placeholder="example@email.com">
                </div>

                <div class="form-group">
                    <label class="form-label">MESSAGE</label>

                    <textarea class="form-control"
                              rows="6"
                              placeholder="Write your message..."
                              style="resize:none;"></textarea>
                </div>

                <button class="btn-primary">
                    SEND MESSAGE
                </button>

            </form>

        </div>

        <!-- INFO -->
        <div>

            <div class="auth-card" style="margin-bottom:24px;">

                <h3 style="margin-bottom:14px;">Store Address</h3>

                <p class="card-sub">
                    Cairo, Egypt<br>
                    New Cairo District
                </p>

            </div>

            <div class="auth-card" style="margin-bottom:24px;">

                <h3 style="margin-bottom:14px;">Email</h3>

                <p class="card-sub">
                    support@cozastore.com
                </p>

            </div>

            <div class="auth-card">

                <h3 style="margin-bottom:14px;">Phone</h3>

                <p class="card-sub">
                    +20 100 000 0000
                </p>

            </div>

        </div>

    </div>

</section>F