@{
    ViewData["Title"] = "Contact Us";
    Layout = "~/Views/Shared/_ShopLayout.cshtml";
}

@section Styles {
    <style>
        .contact-container {
            max-width: 1200px;
            margin: 0 auto;
            width: 100%;
            padding: 40px 20px 80px;
            animation: fadeUp 0.5s ease both;
        }

        /* =========================================
           BREADCRUMB
        ========================================= */
        .breadcrumb {
            font-family: var(--font-display);
            font-size: 12px;
            letter-spacing: 2px;
            color: var(--primary-text);
            text-transform: uppercase;
            margin-bottom: 40px;
            display: flex;
            gap: 12px;
            align-items: center;
            font-weight: 600;
        }

        .breadcrumb a {
            color: var(--primary-text);
            text-decoration: none;
            transition: var(--transition);
        }

        .breadcrumb a:hover {
            color: var(--accent);
        }

        .breadcrumb .sep {
            color: var(--gray-mid);
        }

        .breadcrumb .current {
            color: var(--accent);
            font-weight: 700;
        }

        /* =========================================
           LAYOUT GRID
        ========================================= */
        .contact-grid {
            display: grid;
            grid-template-columns: 1.5fr 1fr;
            gap: 40px;
            align-items: start;
        }

        /* =========================================
           CONTACT FORM CARD
        ========================================= */
        .contact-form-card {
            background: var(--white);
            padding: 48px;
            border-radius: 16px;
            box-shadow: var(--shadow-md);
            border: 1px solid var(--gray-light);
        }

        .card-eyebrow {
            font-family: var(--font-display);
            font-size: 13px;
            letter-spacing: 3px;
            color: var(--accent);
            text-transform: uppercase;
            font-weight: 700;
            margin-bottom: 12px;
        }

        .card-title {
            font-family: var(--font-display);
            font-size: 36px;
            font-weight: 700;
            color: var(--primary-dark);
            margin-bottom: 16px;
            line-height: 1.2;
        }

        .card-sub {
            font-size: 15px;
            color: var(--primary-text);
            margin-bottom: 40px;
            line-height: 1.6;
        }

        /* Form Elements */
        .form-group {
            margin-bottom: 24px;
        }

        .form-label {
            display: block;
            font-family: var(--font-display);
            font-size: 13px;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: var(--primary-dark);
            margin-bottom: 8px;
        }

        .form-control {
            width: 100%;
            border: 1.5px solid var(--gray-mid);
            padding: 16px;
            font-family: var(--font-body);
            font-size: 14px;
            color: var(--primary-dark);
            background: var(--gray-light);
            border-radius: 8px;
            outline: none;
            transition: var(--transition);
        }

        .form-control:focus {
            border-color: var(--accent);
            background: var(--white);
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);
        }

        .btn-submit {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            width: 100%;
            background: var(--primary-dark);
            color: var(--white);
            font-family: var(--font-display);
            font-size: 14px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            padding: 18px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            transition: var(--transition);
            margin-top: 16px;
        }

        .btn-submit:hover {
            background: var(--accent);
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
        }

        /* =========================================
           INFO CARDS
        ========================================= */
        .info-cards-wrapper {
            display: flex;
            flex-direction: column;
            gap: 24px;
        }

        .info-card {
            background: var(--white);
            padding: 32px;
            border-radius: 16px;
            box-shadow: var(--shadow-sm);
            border: 1px solid var(--gray-light);
            display: flex;
            align-items: flex-start;
            gap: 20px;
            transition: var(--transition);
        }

        .info-card:hover {
            transform: translateX(-8px);
            box-shadow: var(--shadow-md);
            border-color: var(--accent);
        }

        .info-icon {
            width: 56px;
            height: 56px;
            background: rgba(79, 70, 229, 0.1);
            color: var(--accent);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            transition: var(--transition);
        }

        .info-card:hover .info-icon {
            background: var(--accent);
            color: var(--white);
        }

        .info-content h3 {
            font-family: var(--font-display);
            font-size: 18px;
            font-weight: 700;
            color: var(--primary-dark);
            margin-bottom: 8px;
            letter-spacing: 1px;
        }

        .info-content p {
            font-size: 15px;
            color: var(--primary-text);
            line-height: 1.6;
            margin: 0;
        }

        @@keyframes fadeUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @@media (max-width: 992px) {
            .contact-grid {
                grid-template-columns: 1fr;
            }
            .info-card:hover {
                transform: translateY(-8px);
            }
        }

        @@media (max-width: 600px) {
            .contact-form-card {
                padding: 32px 24px;
            }
        }
    </style>
}

<div class="contact-container">
    
    <div class="breadcrumb">
        <a asp-controller="Home" asp-action="Index">Home</a>
        <span class="sep">/</span>
        <span class="current">Contact</span>
    </div>

    <div class="contact-grid">

        <div class="contact-form-card">
            <div class="card-eyebrow">Get In Touch</div>
            <h1 class="card-title">Contact Us</h1>
            <p class="card-sub">We'd love to hear from you. Please fill out the form below and our team will get back to you shortly.</p>

            <form>
                <div class="form-group">
                    <label class="form-label">Full Name</label>
                    <input class="form-control" type="text" placeholder="e.g. John Doe">
                </div>

                <div class="form-group">
                    <label class="form-label">Email Address</label>
                    <input class="form-control" type="email" placeholder="example@email.com">
                </div>

                <div class="form-group">
                    <label class="form-label">Message</label>
                    <textarea class="form-control" rows="6" placeholder="Write your message here..." style="resize:none;"></textarea>
                </div>

                <button type="button" class="btn-submit">
                    Send Message
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                        <line x1="22" y1="2" x2="11" y2="13"></line>
                        <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                    </svg>
                </button>
            </form>
        </div>

        <div class="info-cards-wrapper">

            <div class="info-card">
                <div class="info-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="24" height="24">
                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                        <circle cx="12" cy="10" r="3"></circle>
                    </svg>
                </div>
                <div class="info-content">
                    <h3>Store Address</h3>
                    <p>Cairo, Egypt<br>New Cairo District</p>
                </div>
            </div>

            <div class="info-card">
                <div class="info-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="24" height="24">
                        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                        <polyline points="22,6 12,13 2,6"></polyline>
                    </svg>
                </div>
                <div class="info-content">
                    <h3>Email</h3>
                    <p>support@cozastore.com</p>
                </div>
            </div>

            <div class="info-card">
                <div class="info-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="24" height="24">
                        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                    </svg>
                </div>
                <div class="info-content">
                    <h3>Phone</h3>
                    <p>+20 100 000 0000</p>
                </div>
            </div>

        </div>

    </div>
</div>