@model List<Product>

@{
    ViewData["Title"] = "Home";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        .btn-favorite {
        position: absolute;
        top: 16px;
        right: 16px;
        background: var(--white);
        border: none;
        border-radius: 50%;
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        transition: transform 0.2s;
        color: var(--black);
        }
        .btn-favorite:hover {
            transform: scale(1.1);
        }
        .btn-favorite svg {
            width: 18px;
            height: 18px;
            transition: fill 0.3s, stroke 0.3s;
        }
        .price-old { font-size: 14px; color: var(--gray-text); text-decoration: line-through; }
        .hero-section { width: 100%; text-align: center; background: var(--white); padding: 60px 20px; margin-bottom: 50px; border-radius: 8px; box-shadow: 0 4px 24px rgba(0,0,0,.04); }
        .hero-title { font-family: var(--font-display); font-size: 36px; font-weight: 700; letter-spacing: 5px; text-transform: uppercase; color: var(--black); margin-bottom: 16px; }
        .hero-subtitle { font-size: 15px; color: var(--gray-text); letter-spacing: 1px; line-height: 1.6; }
        .products-container { width: 100%; max-width: 1200px; }
        .filter-sort-bar { display: flex; gap: 20px; margin-bottom: 36px; align-items: center; background: var(--white); padding: 20px; border: 1px solid var(--gray-mid); border-radius: 4px; }
        .filter-group { display: flex; align-items: center; gap: 12px; }
        .filter-label { font-family: var(--font-display); font-size: 12px; letter-spacing: 2px; font-weight: 600; text-transform: uppercase; color: var(--black); }
        .filter-select { padding: 10px 14px; border: 1.5px solid var(--gray-mid); font-family: var(--font-body); font-size: 13px; cursor: pointer; background: var(--white); color: var(--black); border-radius: 3px; transition: border-color 0.2s; }
        .filter-select:hover { border-color: var(--accent); }
        .reset-btn { background: var(--gray-light); color: var(--black); border: 1.5px solid var(--gray-mid); padding: 10px 18px; font-family: var(--font-display); font-size: 11px; letter-spacing: 1.5px; cursor: pointer; transition: all 0.2s; border-radius: 3px; }
        .reset-btn:hover { background: var(--black); color: var(--white); border-color: var(--black); }
        .section-heading { font-family: var(--font-display); font-size: 24px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; margin-bottom: 36px; text-align: center; color: var(--black); }
        .products-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 32px; }
        .product-card { background: var(--white); display: flex; flex-direction: column; position: relative; transition: transform 0.3s ease, box-shadow 0.3s ease; border: 1px solid var(--gray-mid); }
        .product-card:hover { transform: translateY(-8px); box-shadow: 0 12px 36px rgba(0,0,0,.08); border-color: transparent; }
        .product-img-wrapper { position: relative; width: 100%; height: 300px; background: var(--gray-light); overflow: hidden; }
        .product-img-wrapper img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
        .product-card:hover .product-img-wrapper img { transform: scale(1.05); }
        .discount-badge { position: absolute; top: 16px; left: 16px; background: var(--error); color: var(--white); font-family: var(--font-display); font-size: 10px; font-weight: 700; letter-spacing: 2px; padding: 6px 12px; border-radius: 4px; }
        .product-details { padding: 24px 20px; display: flex; flex-direction: column; flex-grow: 1; }
        .product-category { font-size: 11px; color: var(--gray-text); text-transform: uppercase; letter-spacing: 2px; margin-bottom: 8px; font-family: var(--font-display); }
        .product-name { font-family: var(--font-display); font-size: 16px; font-weight: 600; color: var(--black); text-decoration: none; letter-spacing: 1px; line-height: 1.4; margin-bottom: 16px; transition: color 0.2s; }
        .product-name:hover { color: var(--accent); }
        .product-meta { margin-top: auto; display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
        .product-price { font-size: 18px; font-weight: 700; color: var(--black); }
        .product-stock { font-size: 12px; color: var(--gray-text); }
        .product-stock span { color: var(--success); font-weight: bold; }
        .btn-card { width: 100%; text-align: center; padding: 12px; }
        .empty-state { text-align: center; padding: 60px 20px; background: var(--white); border: 1px dashed var(--gray-mid); color: var(--gray-text); }

        /* New styles for dropdown filters */
        .filter-dropdown {
            position: relative;
            display: inline-block;
        }

        .dropdown-content {
            display: none;
            position: absolute;
            background-color: var(--white);
            min-width: 220px;
            box-shadow: 0 8px 16px rgba(0,0,0,0.2);
            padding: 12px 16px;
            z-index: 1;
            border: 1px solid var(--gray-mid);
            border-radius: 4px;
            max-height: 300px;
            overflow-y: auto;
            top: 100%;
            left: 0;
        }

        .dropdown-content.show {
            display: block;
        }

        .dropdown-content label {
            display: flex;
            align-items: center;
            padding: 8px 0;
            cursor: pointer;
            font-size: 13px;
            color: var(--black);
        }

        .dropdown-content input[type="checkbox"] {
            margin-right: 10px;
            width: 16px;
            height: 16px;
            cursor: pointer;
        }

        .filter-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 10px;
            min-height: 20px;
        }

        .filter-tag {
            background: var(--accent);
            color: var(--white);
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-family: var(--font-display);
            letter-spacing: 1px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .filter-tag .remove-tag {
            cursor: pointer;
            font-weight: bold;
            font-size: 16px;
            line-height: 1;
        }

        .filter-tag .remove-tag:hover {
            opacity: 0.8;
        }

        .price-slider-wrapper {
    position: relative;
    margin: 0;
    height: 30px;
    width: 100%;
}

.price-slider {
    position: absolute;
    width: 100%;
    height: 5px;
    top: 50%;
    transform: translateY(-50%);
    -webkit-appearance: none;
    appearance: none;
    background: transparent;
    pointer-events: none;
    cursor: pointer;
    z-index: 5;
}

#minPriceSlider {
    z-index: 6;
}

#maxPriceSlider {
    z-index: 4;
}

.price-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--accent);
    cursor: pointer;
    pointer-events: auto;
    box-shadow: 0 2px 6px rgba(0,0,0,0.2);
    margin-top: -5.5px;
}

.price-slider::-moz-range-thumb {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--accent);
    cursor: pointer;
    pointer-events: auto;
    border: none;
    box-shadow: 0 2px 6px rgba(0,0,0,0.2);
    z-index: 5;
}

.price-slider::-moz-range-track {
    background: transparent;
    height: 5px;
    border: none;
    border-radius: 2px;
}

.price-slider::-webkit-slider-runnable-track {
    background: transparent;
    height: 5px;
    border: none;
    border-radius: 2px;
}

.price-slider::-moz-range-progress {
    background-color: transparent;
}

.price-display {
    text-align: center;
    font-size: 14px;
    font-weight: 600;
    color: var(--black);
    margin-top: 10px;
}

/* Toggle Switch Styles */
.toggle-switch {
    position: relative;
    display: inline-block;
    width: 50px;
    height: 24px;
}

.toggle-switch input {
    opacity: 0;
    width: 0;
    height: 0;
}

.toggle-slider {
    position: absolute;
    cursor: pointer;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--gray-mid);
    transition: 0.3s;
    border-radius: 24px;
}

.toggle-slider:before {
    position: absolute;
    content: "";
    height: 18px;
    width: 18px;
    left: 3px;
    bottom: 3px;
    background-color: var(--white);
    transition: 0.3s;
    border-radius: 50%;
}

input:checked + .toggle-slider {
    background-color: var(--accent);
}

input:checked + .toggle-slider:before {
    transform: translateX(26px);
}

.toggle-label {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
}

.toggle-label-text {
    font-family: var(--font-display);
    font-size: 11px;
    letter-spacing: 1px;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--black);
}

/* Price slider container in filter bar */
.price-slider-inline {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: 1;
    min-width: 250px;
}

.price-slider-inline .filter-label {
    white-space: nowrap;
}

.price-slider-inline .price-slider-wrapper {
    flex: 1;
    margin: 0;
    height: 24px;
}
    </style>
}

<div class="hero-section">
    <h1 class="hero-title">Discover Your Style</h1>
    <p class="hero-subtitle">Browse our exclusive collection of premium men's accessories</p>
</div>

<div class="products-container">
    @if (Model != null && Model.Any())
    {
        <div class="filter-sort-bar">
            <!-- SEARCH -->
            <div class="filter-group">
                <label class="filter-label">Search:</label>
                <input type="text" id="searchInput" class="filter-select" placeholder="Search products..." onkeyup="debounceSearch()">
            </div>

            <!-- CATEGORY FILTER -->
            <div class="filter-group">
                <label class="filter-label">Filter:</label>
                <div class="filter-dropdown">
                    <button class="filter-select" onclick="toggleDropdown()">Categories ▼</button>
                    <div id="filterDropdown" class="dropdown-content">
                        @foreach (var category in ViewBag.Categories)
                        {
                            <label>
                                <input type="checkbox" value="@category.Id" onchange="onCategoryChange()">
                                @category.Name
                            </label>
                        }
                    </div>
                </div>
            </div>

            <!-- SORT -->
            <div class="filter-group">
                <label class="filter-label">Sort:</label>
                <select id="sortFilter" class="filter-select" onchange="loadProducts()">
                    <option value="default">Default</option>
                    <option value="name_asc">Name (A-Z)</option>
                    <option value="name_desc">Name (Z-A)</option>
                    <option value="price_asc">Price (Low-High)</option>
                    <option value="price_desc">Price (High-Low)</option>
                    <option value="newest">Newest</option>
                    <option value="oldest">Oldest</option>
                </select>
            </div>

            <!-- PRICE RANGE SLIDER -->
            <div class="price-slider-inline">
                <label class="filter-label">Price:</label>
                <div style="display: flex; flex-direction: column; gap: 8px; flex: 1;">
                    <div class="price-slider-wrapper">
                        <input type="range" id="minPriceSlider" class="price-slider" min="0" max="1000" value="0" oninput="updatePriceDisplay()" onchange="loadProducts()">
                        <input type="range" id="maxPriceSlider" class="price-slider" min="0" max="1000" value="1000" oninput="updatePriceDisplay()" onchange="loadProducts()">
                    </div>
                    <div class="price-display" style="margin-top: 0; font-size: 12px;">
                        <span id="minPriceDisplay">$0</span> - <span id="maxPriceDisplay">$1000</span>
                    </div>
                </div>
            </div>

            <!-- STOCK FILTER -->
            <div class="filter-group">
                <div class="toggle-label" style="gap: 4px;">
                    <label class="toggle-switch">
                        <input type="checkbox" id="inStockFilter" onchange="loadProducts()">
                        <span class="toggle-slider"></span>
                    </label>
                    <span class="toggle-label-text">In Stock Only</span>
                </div>
            </div>

            <!-- RESET FILTERS -->
            <button class="reset-btn" onclick="resetFilters()">Reset</button>

        </div>

            <!-- FILTER TAGS -->
                <div class="filter-tags" id="filterTags"></div>

                <h2 class="section-heading">Featured Products</h2>

                <div id="productsContainer">
                    <partial name="_ProductsGrid" model="Model" />
                </div>
    }
    else
    {
        <div class="empty-state">
            <h3>No Products Found</h3>
            <p>We are currently updating our catalog. Please check back later.</p>
        </div>
    }
</div>

@section Scripts {
    <script>
        let selectedCategories = [];
        let searchTimeout;
        let globalMinPrice = 0;
        let globalMaxPrice = 1000;

        const categoryMap = new Map([
            @foreach (var cat in ViewBag.Categories)
            {
                @Html.Raw($"[{cat.Id}, '{cat.Name}'],")
            }
        ]);

        // Init price slider on page load
        window.addEventListener('load', initPriceSlider);

        function initPriceSlider() {
            fetch('/Home/GetPriceRange')
                .then(r => r.json())
                .then(data => {
                    globalMinPrice = Math.floor(data.min);
                    globalMaxPrice = Math.ceil(data.max);

                    document.getElementById('minPriceSlider').min = globalMinPrice;
                    document.getElementById('minPriceSlider').max = globalMaxPrice;
                    document.getElementById('maxPriceSlider').min = globalMinPrice;
                    document.getElementById('maxPriceSlider').max = globalMaxPrice;
                    document.getElementById('minPriceSlider').value = globalMinPrice;
                    document.getElementById('maxPriceSlider').value = globalMaxPrice;

                    document.getElementById('minPriceDisplay').textContent = '$' + Math.floor(globalMinPrice);
                    document.getElementById('maxPriceDisplay').textContent = '$' + Math.ceil(globalMaxPrice);

                    // Initialize colored line on page load
                    updateSliderTrack();

                    // Add event listeners for z-index swapping
                    setupSliderZIndexSwap();
                });
        }

        function setupSliderZIndexSwap() {
            const minSlider = document.getElementById('minPriceSlider');
            const maxSlider = document.getElementById('maxPriceSlider');

            const bringToFront = (active, inactive) => {
                active.style.zIndex = '6';
                inactive.style.zIndex = '5';
            };

            const resetZIndex = () => {
                minSlider.style.zIndex = '6';
                maxSlider.style.zIndex = '5';
            };

            minSlider.addEventListener('mousedown', () => bringToFront(minSlider, maxSlider));
            minSlider.addEventListener('touchstart', () => bringToFront(minSlider, maxSlider));

            maxSlider.addEventListener('mousedown', () => bringToFront(maxSlider, minSlider));
            maxSlider.addEventListener('touchstart', () => bringToFront(maxSlider, minSlider));

            document.addEventListener('mouseup', resetZIndex);
            document.addEventListener('touchend', resetZIndex);
        }

        function debounceSearch() {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(() => loadProducts(), 300);
        }

        function toggleDropdown() {
            const dropdown = document.getElementById('filterDropdown');
            dropdown.classList.toggle('show');
        }

        // Close dropdown when clicking outside
        document.addEventListener('click', function(e) {
            const filterDropdown = document.querySelector('.filter-dropdown');
            if (!filterDropdown.contains(e.target)) {
                document.getElementById('filterDropdown').classList.remove('show');
            }
        });

        function onCategoryChange() {
            const checkboxes = document.querySelectorAll('#filterDropdown input[type="checkbox"]');
            selectedCategories = [];

            checkboxes.forEach(checkbox => {
                if (checkbox.checked) {
                    selectedCategories.push(parseInt(checkbox.value));
                }
            });

            renderTags();
            loadProducts();
        }

        function renderTags() {
            const tagsContainer = document.getElementById('filterTags');
            tagsContainer.innerHTML = '';

            selectedCategories.forEach(catId => {
                const categoryName = categoryMap.get(catId);
                const tag = document.createElement('div');
                tag.className = 'filter-tag';
                tag.innerHTML = `
                    ${categoryName}
                    <span class="remove-tag" onclick="removeTag(${catId})">✕</span>
                `;
                tagsContainer.appendChild(tag);
            });
        }

        function removeTag(catId) {
            selectedCategories = selectedCategories.filter(id => id !== catId);

            // Uncheck the checkbox
            const checkbox = document.querySelector(`#filterDropdown input[value="${catId}"]`);
            if (checkbox) checkbox.checked = false;

            renderTags();
            loadProducts();
        }

        function updatePriceDisplay() {
            const minSlider = document.getElementById('minPriceSlider');
            const maxSlider = document.getElementById('maxPriceSlider');

            // Swap values if min > max
            if (parseInt(minSlider.value) > parseInt(maxSlider.value)) {
                [minSlider.value, maxSlider.value] = [maxSlider.value, minSlider.value];
            }

            // Update display only (no AJAX call)
            document.getElementById('minPriceDisplay').textContent = '$' + minSlider.value;
            document.getElementById('maxPriceDisplay').textContent = '$' + maxSlider.value;

            // Update slider track color between thumbs
            updateSliderTrack();
        }

        function updateSliderTrack() {
            const minSlider = document.getElementById('minPriceSlider');
            const maxSlider = document.getElementById('maxPriceSlider');
            const min = parseInt(minSlider.min);
            const max = parseInt(minSlider.max);
            const minVal = parseInt(minSlider.value);
            const maxVal = parseInt(maxSlider.value);

            // Calculate percentage positions
            const minPercent = ((minVal - min) / (max - min)) * 100;
            const maxPercent = ((maxVal - min) / (max - min)) * 100;

            // Update background gradient on both sliders
            minSlider.style.background = `linear-gradient(to right, var(--gray-mid) 0%, var(--gray-mid) ${minPercent}%, var(--accent) ${minPercent}%, var(--accent) ${maxPercent}%, var(--gray-mid) ${maxPercent}%, var(--gray-mid) 100%)`;
            maxSlider.style.background = `linear-gradient(to right, var(--gray-mid) 0%, var(--gray-mid) ${minPercent}%, var(--accent) ${minPercent}%, var(--accent) ${maxPercent}%, var(--gray-mid) ${maxPercent}%, var(--gray-mid) 100%)`;
        }

        function loadProducts() {
            const categoryIds = selectedCategories.join(',');
            const sortBy = document.getElementById('sortFilter').value || 'default';
            const keyword = document.getElementById('searchInput').value || '';
            const inStock = document.getElementById('inStockFilter').checked;

            // Get price range values
            const minPrice = document.getElementById('minPriceSlider').value;
            const maxPrice = document.getElementById('maxPriceSlider').value;

            fetch(`/Home/FilterAndSort?categoryIds=${categoryIds}&sortBy=${sortBy}&keyword=${encodeURIComponent(keyword)}&inStock=${inStock}&minPrice=${minPrice}&maxPrice=${maxPrice}`)
                .then(response => response.text())
                .then(html => {
                    document.getElementById('productsContainer').innerHTML = html;
                    // Update price slider range based on filtered results
                    updatePriceSliderRange();
                })
                .catch(error => console.error('Error:', error));
        }

        function updatePriceSliderRange() {
            // Get current filtered products to update slider range
            fetch('/Home/GetPriceRange')
                .then(r => r.json())
                .then(data => {
                    const newMin = Math.floor(data.min);
                    const newMax = Math.ceil(data.max);

                    // Update slider max value to reflect current filtered products
                    document.getElementById('maxPriceSlider').max = newMax > 0 ? newMax : 1000;
                    document.getElementById('minPriceSlider').max = newMax > 0 ? newMax : 1000;
                });
        }

        function resetFilters() {
            selectedCategories = [];
            document.getElementById('searchInput').value = '';
            document.querySelectorAll('#filterDropdown input[type="checkbox"]').forEach(cb => cb.checked = false);
            document.getElementById('sortFilter').value = 'default';
            document.getElementById('inStockFilter').checked = false;

            // Reset sliders to initial range
            initPriceSlider();

            renderTags();
            loadProducts();
        }
    </script>
}