@model List<Product>

@{
    ViewData["Title"] = "Home";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        .btn-favorite {
        position: absolute;
        top: 16px;
        right: 16px;
        background: var(--white);
        border: none;
        border-radius: 50%;
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        transition: transform 0.2s;
        color: var(--black);
        }
        .btn-favorite:hover {
            transform: scale(1.1);
        }
        .btn-favorite svg {
            width: 18px;
            height: 18px;
            transition: fill 0.3s, stroke 0.3s;
        }
        .price-old { font-size: 14px; color: var(--gray-text); text-decoration: line-through; }
        .hero-section { width: 100%; text-align: center; background: var(--white); padding: 60px 20px; margin-bottom: 50px; border-radius: 8px; box-shadow: 0 4px 24px rgba(0,0,0,.04); }
        .hero-title { font-family: var(--font-display); font-size: 36px; font-weight: 700; letter-spacing: 5px; text-transform: uppercase; color: var(--black); margin-bottom: 16px; }
        .hero-subtitle { font-size: 15px; color: var(--gray-text); letter-spacing: 1px; line-height: 1.6; }
        .products-container { width: 100%; max-width: 1200px; }
        .filter-sort-bar { display: flex; gap: 20px; margin-bottom: 36px; align-items: center; background: var(--white); padding: 20px; border: 1px solid var(--gray-mid); border-radius: 4px; }
        .filter-group { display: flex; align-items: center; gap: 12px; }
        .filter-label { font-family: var(--font-display); font-size: 12px; letter-spacing: 2px; font-weight: 600; text-transform: uppercase; color: var(--black); }
        .filter-select { padding: 10px 14px; border: 1.5px solid var(--gray-mid); font-family: var(--font-body); font-size: 13px; cursor: pointer; background: var(--white); color: var(--black); border-radius: 3px; transition: border-color 0.2s; }
        .filter-select:hover { border-color: var(--accent); }
        .reset-btn { background: var(--gray-light); color: var(--black); border: 1.5px solid var(--gray-mid); padding: 10px 18px; font-family: var(--font-display); font-size: 11px; letter-spacing: 1.5px; cursor: pointer; transition: all 0.2s; border-radius: 3px; }
        .reset-btn:hover { background: var(--black); color: var(--white); border-color: var(--black); }
        .section-heading { font-family: var(--font-display); font-size: 24px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; margin-bottom: 36px; text-align: center; color: var(--black); }
        .products-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 32px; }
        .product-card { background: var(--white); display: flex; flex-direction: column; position: relative; transition: transform 0.3s ease, box-shadow 0.3s ease; border: 1px solid var(--gray-mid); }
        .product-card:hover { transform: translateY(-8px); box-shadow: 0 12px 36px rgba(0,0,0,.08); border-color: transparent; }
        .product-img-wrapper { position: relative; width: 100%; height: 300px; background: var(--gray-light); overflow: hidden; }
        .product-img-wrapper img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
        .product-card:hover .product-img-wrapper img { transform: scale(1.05); }
        .discount-badge { position: absolute; top: 16px; left: 16px; background: var(--error); color: var(--white); font-family: var(--font-display); font-size: 10px; font-weight: 700; letter-spacing: 2px; padding: 6px 12px; border-radius: 4px; }
        .product-details { padding: 24px 20px; display: flex; flex-direction: column; flex-grow: 1; }
        .product-category { font-size: 11px; color: var(--gray-text); text-transform: uppercase; letter-spacing: 2px; margin-bottom: 8px; font-family: var(--font-display); }
        .product-name { font-family: var(--font-display); font-size: 16px; font-weight: 600; color: var(--black); text-decoration: none; letter-spacing: 1px; line-height: 1.4; margin-bottom: 16px; transition: color 0.2s; }
        .product-name:hover { color: var(--accent); }
        .product-meta { margin-top: auto; display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
        .product-price { font-size: 18px; font-weight: 700; color: var(--black); }
        .product-stock { font-size: 12px; color: var(--gray-text); }
        .product-stock span { color: var(--success); font-weight: bold; }
        .btn-card { width: 100%; text-align: center; padding: 12px; }
        .empty-state { text-align: center; padding: 60px 20px; background: var(--white); border: 1px dashed var(--gray-mid); color: var(--gray-text); }

        /* New styles for dropdown filters */
        .filter-dropdown {
            position: relative;
            display: inline-block;
        }

        .dropdown-content {
            display: none;
            position: absolute;
            background-color: var(--white);
            min-width: 220px;
            box-shadow: 0 8px 16px rgba(0,0,0,0.2);
            padding: 12px 16px;
            z-index: 1;
            border: 1px solid var(--gray-mid);
            border-radius: 4px;
            max-height: 300px;
            overflow-y: auto;
            top: 100%;
            left: 0;
        }

        .dropdown-content.show {
            display: block;
        }

        .dropdown-content label {
            display: flex;
            align-items: center;
            padding: 8px 0;
            cursor: pointer;
            font-size: 13px;
            color: var(--black);
        }

        .dropdown-content input[type="checkbox"] {
            margin-right: 10px;
            width: 16px;
            height: 16px;
            cursor: pointer;
        }

        .filter-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 10px;
            min-height: 20px;
        }

        .filter-tag {
            background: var(--accent);
            color: var(--white);
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-family: var(--font-display);
            letter-spacing: 1px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .filter-tag .remove-tag {
            cursor: pointer;
            font-weight: bold;
            font-size: 16px;
            line-height: 1;
        }

        .filter-tag .remove-tag:hover {
            opacity: 0.8;
        }
    </style>
}

<div class="hero-section">
    <h1 class="hero-title">Discover Your Style</h1>
    <p class="hero-subtitle">Browse our exclusive collection of premium men's accessories</p>
</div>

<div class="products-container">
    @if (Model != null && Model.Any())
    {
        <div class="filter-sort-bar">
    <div class="filter-group">
        <label class="filter-label">Search:</label>
        <input type="text" id="searchInput" class="filter-select" placeholder="Search products..." onkeyup="debounceSearch()">
    </div>

    <div class="filter-group">
            <label class="filter-label">Filter:</label>
            <div class="filter-dropdown">
                <button class="filter-select" onclick="toggleDropdown()">Categories ▼</button>
                <div id="filterDropdown" class="dropdown-content">
                    @foreach (var category in ViewBag.Categories)
                    {
                        <label>
                            <input type="checkbox" value="@category.Id" onchange="onCategoryChange()">
                            @category.Name
                        </label>
                    }
                </div>
            </div>
        </div>

        <div class="filter-group">
            <label class="filter-label">Sort:</label>
            <select id="sortFilter" class="filter-select" onchange="loadProducts()">
                <option value="default">Default</option>
                <option value="name_asc">Name (A-Z)</option>
                <option value="name_desc">Name (Z-A)</option>
                <option value="price_asc">Price (Low-High)</option>
                <option value="price_desc">Price (High-Low)</option>
                <option value="newest">Newest</option>
                <option value="oldest">Oldest</option>
            </select>
        </div>

        <button class="reset-btn" onclick="resetFilters()">Reset</button>
    </div>

        <!-- FILTER TAGS -->
        <div class="filter-tags" id="filterTags"></div>

        <h2 class="section-heading">Featured Products</h2>

        <div id="productsContainer">
            <partial name="_ProductsGrid" model="Model" />
        </div>
    }
    else
    {
        <div class="empty-state">
            <h3>No Products Found</h3>
            <p>We are currently updating our catalog. Please check back later.</p>
        </div>
    }
</div>

@section Scripts {
    <script>
        let selectedCategories = [];
        let searchTimeout;
        const categoryMap = new Map([
            @foreach (var cat in ViewBag.Categories)
            {
                @Html.Raw($"[{cat.Id}, '{cat.Name}'],")
            }
        ]);

        function debounceSearch() {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(() => loadProducts(), 300);
        }

        function toggleDropdown() {
            const dropdown = document.getElementById('filterDropdown');
            dropdown.classList.toggle('show');
        }

        // Close dropdown when clicking outside
        document.addEventListener('click', function(e) {
            const filterDropdown = document.querySelector('.filter-dropdown');
            if (!filterDropdown.contains(e.target)) {
                document.getElementById('filterDropdown').classList.remove('show');
            }
        });

        function onCategoryChange() {
            const checkboxes = document.querySelectorAll('#filterDropdown input[type="checkbox"]');
            selectedCategories = [];

            checkboxes.forEach(checkbox => {
                if (checkbox.checked) {
                    selectedCategories.push(parseInt(checkbox.value));
                }
            });

            renderTags();
            loadProducts();
        }

        function renderTags() {
            const tagsContainer = document.getElementById('filterTags');
            tagsContainer.innerHTML = '';

            selectedCategories.forEach(catId => {
                const categoryName = categoryMap.get(catId);
                const tag = document.createElement('div');
                tag.className = 'filter-tag';
                tag.innerHTML = `
                    ${categoryName}
                    <span class="remove-tag" onclick="removeTag(${catId})">✕</span>
                `;
                tagsContainer.appendChild(tag);
            });
        }

        function removeTag(catId) {
            selectedCategories = selectedCategories.filter(id => id !== catId);
    
            // Uncheck the checkbox
            const checkbox = document.querySelector(`#filterDropdown input[value="${catId}"]`);
            if (checkbox) checkbox.checked = false;

            renderTags();
            loadProducts();
        }

        function loadProducts() {
            const categoryIds = selectedCategories.join(',');
            const sortBy = document.getElementById('sortFilter').value || 'default';
            const keyword = document.getElementById('searchInput').value || '';

            fetch(`/Home/FilterAndSort?categoryIds=${categoryIds}&sortBy=${sortBy}&keyword=${encodeURIComponent(keyword)}`)
                .then(response => response.text())
                .then(html => {
                    document.getElementById('productsContainer').innerHTML = html;
                })
                .catch(error => console.error('Error:', error));
        }

        function resetFilters() {
            selectedCategories = [];
            document.getElementById('searchInput').value = '';
            document.querySelectorAll('#filterDropdown input[type="checkbox"]').forEach(cb => cb.checked = false);
            document.getElementById('sortFilter').value = 'default';
            renderTags();
            loadProducts();
        }
    </script>
}