@model List<Product>

@{
    ViewData["Title"] = "Home";
    Layout = "~/Views/Shared/_ShopLayout.cshtml";
}

@section Styles {
    <style>
        /* =========================================
           HERO SECTION
        ========================================= */
        .hero-section { 
            width: 100%; 
            text-align: center; 
            background: linear-gradient(135deg, var(--primary-dark) 0%, #1E293B 100%);
            padding: 80px 20px; 
            margin-bottom: 50px; 
            border-radius: 16px; 
            box-shadow: var(--shadow-md);
            color: var(--white);
        }
        .hero-title { 
            font-family: var(--font-display); 
            font-size: 42px; 
            font-weight: 700; 
            letter-spacing: 4px; 
            text-transform: uppercase;
            margin-bottom: 16px; 
        }
        .hero-subtitle { 
            font-size: 16px; 
            color: var(--gray-mid); 
            letter-spacing: 1px;
            line-height: 1.6; 
            font-weight: 300;
        }

        /* =========================================
           FILTERS & SORTING BAR
        ========================================= */
        .products-container { width: 100%; max-width: 1400px; margin: 0 auto; }
        
        .filter-sort-bar { 
            display: flex; 
            flex-wrap: wrap;
            gap: 20px; 
            margin-bottom: 36px; 
            align-items: center; 
            background: var(--white);
            padding: 24px; 
            border-radius: 12px; 
            box-shadow: var(--shadow-sm);
        }
        .filter-group { display: flex; align-items: center; gap: 12px; }
        
        .filter-label { 
            font-family: var(--font-display); 
            font-size: 13px; 
            letter-spacing: 1.5px;
            font-weight: 700; 
            text-transform: uppercase; 
            color: var(--primary-dark); 
        }
        
        .filter-select { 
            padding: 10px 16px;
            border: 1px solid var(--gray-mid); 
            font-family: var(--font-body); 
            font-size: 14px; 
            cursor: pointer; 
            background: var(--gray-light); 
            color: var(--primary-text); 
            border-radius: 8px; 
            transition: var(--transition);
            outline: none;
        }
        .filter-select:hover, .filter-select:focus { 
            border-color: var(--accent); 
            background: var(--white);
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);
        }
        
        .reset-btn { 
            background: var(--gray-light); 
            color: var(--primary-dark); 
            border: 1px solid var(--gray-mid);
            padding: 10px 20px; 
            font-family: var(--font-display); 
            font-size: 12px; 
            letter-spacing: 1.5px; 
            font-weight: 600;
            cursor: pointer; 
            transition: var(--transition); 
            border-radius: 8px;
            text-transform: uppercase;
        }
        .reset-btn:hover { 
            background: var(--primary-dark); 
            color: var(--white); 
            border-color: var(--primary-dark);
        }

        /* Dropdown specific */
        .filter-dropdown { position: relative; display: inline-block; }
        .dropdown-content {
            display: none; position: absolute; background-color: var(--white);
            min-width: 240px; box-shadow: var(--shadow-md); padding: 12px 16px;
            z-index: 10; border: 1px solid var(--gray-mid); border-radius: 8px;
            max-height: 300px; overflow-y: auto; top: calc(100% + 8px); left: 0;
        }
        .dropdown-content.show { display: block; animation: fadeIn 0.2s ease; }
        .dropdown-content label {
            display: flex; align-items: center; padding: 10px 8px; cursor: pointer;
            font-size: 14px; color: var(--primary-text); transition: var(--transition);
            border-radius: 6px;
        }
        .dropdown-content label:hover { background: var(--gray-light); color: var(--accent); }
        .dropdown-content input[type="checkbox"] { margin-right: 12px; width: 16px; height: 16px; accent-color: var(--accent); cursor: pointer; }

        /* Filter Tags */
        .filter-tags { display: flex; flex-wrap: wrap; gap: 10px; margin-top: -16px; margin-bottom: 32px; min-height: 20px; }
        .filter-tag {
            background: var(--accent); color: var(--white); padding: 6px 14px;
            border-radius: 20px; font-size: 12px; font-family: var(--font-display);
            letter-spacing: 1px; display: flex; align-items: center; gap: 8px;
            box-shadow: var(--shadow-sm);
        }
        .filter-tag .remove-tag { cursor: pointer; font-weight: bold; font-size: 14px; transition: var(--transition); }
        .filter-tag .remove-tag:hover { transform: scale(1.2); }

        /* =========================================
           PRICE SLIDER (NEW PRO DESIGN)
        ========================================= */
        .price-slider-inline { display: flex; align-items: center; gap: 16px; flex: 1; min-width: 280px; }
        
        .price-slider-wrapper { 
            position: relative; 
            width: 100%; 
            height: 24px; /* Increased height to properly contain thumbs */
            display: flex;
            align-items: center;
            margin: 8px 0;
        }

        /* The base gray track */
        .price-slider-wrapper::before {
            content: '';
            position: absolute;
            width: 100%;
            height: 6px;
            background: var(--gray-mid);
            border-radius: 4px;
            top: 50%;
            transform: translateY(-50%);
        }

        /* The colored active track (controlled by JS) */
        .slider-track {
            position: absolute;
            height: 6px;
            background: var(--accent);
            border-radius: 4px;
            top: 50%;
            transform: translateY(-50%);
            z-index: 1;
        }
        
        .price-slider {
            position: absolute; 
            width: 100%; 
            height: 100%; 
            top: 0; 
            left: 0;
            -webkit-appearance: none; 
            appearance: none; 
            background: transparent; /* Inputs must be completely transparent */
            pointer-events: none; 
            outline: none;
            margin: 0;
            z-index: 2;
        }
        
        #minPriceSlider { z-index: 6; }
        #maxPriceSlider { z-index: 5; }

        .price-slider::-webkit-slider-thumb {
            -webkit-appearance: none; 
            appearance: none; 
            width: 20px; 
            height: 20px;
            border-radius: 50%; 
            background: var(--accent); 
            cursor: pointer;
            pointer-events: auto; 
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25); 
            border: 3px solid var(--white); 
            transition: transform 0.1s;
        }
        
        .price-slider::-webkit-slider-thumb:hover { transform: scale(1.15); }
        
        .price-slider::-moz-range-thumb {
            width: 20px; 
            height: 20px; 
            border-radius: 50%; 
            background: var(--accent); 
            cursor: pointer; 
            pointer-events: auto; 
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25); 
            border: 3px solid var(--white); 
            transition: transform 0.1s;
        }

        .price-display { font-size: 13px; font-weight: 700; color: var(--primary-dark); font-family: var(--font-body); }

        /* Toggle Switch */
        .toggle-switch { position: relative; display: inline-block; width: 44px; height: 24px; }
        .toggle-switch input { opacity: 0; width: 0; height: 0; }
        .toggle-slider {
            position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0;
            background-color: var(--gray-mid); transition: 0.3s; border-radius: 24px;
        }
        .toggle-slider:before {
            position: absolute; content: ""; height: 18px; width: 18px; left: 3px; bottom: 3px;
            background-color: var(--white); transition: 0.3s; border-radius: 50%; box-shadow: var(--shadow-sm);
        }
        input:checked + .toggle-slider { background-color: var(--accent); }
        input:checked + .toggle-slider:before { transform: translateX(20px); }
        .toggle-label { display: flex; flex-direction: column; align-items: center; gap: 6px; }
        .toggle-label-text { font-family: var(--font-display); font-size: 11px; letter-spacing: 1px; font-weight: 700; color: var(--primary-text); }

        /* =========================================
           PRODUCT GRID & CARDS (Inherited by Partial)
        ========================================= */
        .section-heading { 
            font-family: var(--font-display); font-size: 28px; font-weight: 700; 
            letter-spacing: 3px; text-transform: uppercase; margin-bottom: 40px; 
            text-align: center; color: var(--primary-dark); 
        }
        
        .products-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 32px; }
        
        .product-card { 
            background: var(--white); display: flex; flex-direction: column; position: relative; 
            transition: var(--transition); border-radius: 12px; overflow: hidden;
            box-shadow: var(--shadow-sm); border: 1px solid var(--gray-light);
        }
        .product-card:hover { 
            transform: translateY(-8px); 
            box-shadow: var(--shadow-md); 
            border-color: transparent;
        }
        
        .product-img-wrapper { position: relative; width: 100%; height: 320px; background: var(--gray-light); overflow: hidden; }
        .product-img-wrapper img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1); }
        .product-card:hover .product-img-wrapper img { transform: scale(1.08); }
        
        .discount-badge { 
            position: absolute; top: 16px; left: 16px; background: var(--error); color: var(--white);
            font-family: var(--font-display); font-size: 11px; font-weight: 700; letter-spacing: 1.5px; 
            padding: 6px 12px; border-radius: 6px; box-shadow: var(--shadow-sm); z-index: 2;
        }

        .btn-favorite {
            position: absolute; top: 16px; right: 16px; background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(4px); border: none; border-radius: 50%; width: 40px; height: 40px;
            display: flex; align-items: center; justify-content: center; cursor: pointer;
            box-shadow: var(--shadow-sm); transition: var(--transition); color: var(--primary-text); z-index: 2;
        }
        .btn-favorite:hover { transform: scale(1.1); color: var(--error); background: var(--white); }
        .btn-favorite svg { width: 20px; height: 20px; transition: fill 0.3s, stroke 0.3s; }
        
        .product-details { padding: 24px; display: flex; flex-direction: column; flex-grow: 1; }
        .product-category { font-size: 11px; color: var(--accent); text-transform: uppercase; letter-spacing: 2px; margin-bottom: 8px; font-family: var(--font-display); font-weight: 600; }
        .product-name { 
            font-family: var(--font-display); font-size: 18px; font-weight: 700; color: var(--primary-dark);
            text-decoration: none; letter-spacing: 0.5px; line-height: 1.4; margin-bottom: 16px; transition: color 0.2s;
        }
        .product-name:hover { color: var(--accent); }
        
        .product-meta { margin-top: auto; display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; }
        .product-price { font-size: 20px; font-weight: 700; color: var(--primary-dark); font-family: var(--font-body); }
        .price-old { font-size: 14px; color: var(--gray-text); text-decoration: line-through; margin-left: 8px; font-weight: 400; }
        .product-stock { font-size: 13px; color: var(--primary-text); background: var(--gray-light); padding: 4px 10px; border-radius: 20px; }
        .product-stock span { color: var(--success); font-weight: bold; }
        
        .btn-card { 
            width: 100%; text-align: center; padding: 14px; background: var(--primary-dark); 
            color: var(--white); font-family: var(--font-display); text-transform: uppercase; 
            letter-spacing: 2px; font-weight: 700; font-size: 12px; border-radius: 8px; 
            transition: var(--transition); border: none; cursor: pointer; text-decoration: none;
        }
        .btn-card:hover { background: var(--accent); transform: translateY(-2px); box-shadow: var(--shadow-md); }

        .empty-state { 
            text-align: center; padding: 80px 20px; background: var(--white);
            border: 2px dashed var(--gray-mid); border-radius: 12px; color: var(--primary-text); 
        }
        .empty-state h3 { font-family: var(--font-display); font-size: 24px; margin-bottom: 10px; color: var(--primary-dark); }

        @@keyframes fadeIn { from { opacity: 0; transform: translateY(-10px); } to { opacity: 1; transform: translateY(0); } }
    </style>
}

<div class="hero-section">
    <h1 class="hero-title">Discover Your Style</h1>
    <p class="hero-subtitle">Browse our exclusive collection of premium men's accessories</p>
</div>

<div class="products-container">
    @if (Model != null && Model.Any())
    {
        <div class="filter-sort-bar">
            <div class="filter-group">
                <label class="filter-label">Search</label>
                <input type="text" id="searchInput" class="filter-select" placeholder="Search products..." onkeyup="debounceSearch()">
            </div>

            <div class="filter-group">
                <label class="filter-label">Filter</label>
                <div class="filter-dropdown">
                    <button class="filter-select" onclick="toggleDropdown()">Categories ▼</button>
                    <div id="filterDropdown" class="dropdown-content">
                        @foreach (var category in ViewBag.Categories)
                        {
                            <label>
                                <input type="checkbox" value="@category.Id" onchange="onCategoryChange()">
                                @category.Name
                            </label>
                        }
                    </div>
                </div>
            </div>

            <div class="filter-group">
                <label class="filter-label">Sort</label>
                <select id="sortFilter" class="filter-select" onchange="loadProducts()">
                    <option value="default">Default</option>
                    <option value="name_asc">Name (A-Z)</option>
                    <option value="name_desc">Name (Z-A)</option>
                    <option value="price_asc">Price (Low-High)</option>
                    <option value="price_desc">Price (High-Low)</option>
                    <option value="newest">Newest</option>
                    <option value="oldest">Oldest</option>
                </select>
            </div>

            <div class="price-slider-inline">
                <label class="filter-label">Price</label>
                <div style="display: flex; flex-direction: column; gap: 8px; flex: 1;">
                    
                    <div class="price-slider-wrapper">
                        <div class="slider-track" id="sliderTrack"></div> <input type="range" id="minPriceSlider" class="price-slider" min="0" max="1000" value="0" oninput="updatePriceDisplay(this)" onchange="loadProducts()">
                        <input type="range" id="maxPriceSlider" class="price-slider" min="0" max="1000" value="1000" oninput="updatePriceDisplay(this)" onchange="loadProducts()">
                    </div>
                    
                    <div class="price-display" style="margin-top: 4px; display: flex; justify-content: space-between;">
                        <span id="minPriceDisplay">$0</span>
                        <span id="maxPriceDisplay">$1000</span>
                    </div>
                </div>
            </div>

            <div class="filter-group" style="margin-left: auto;">
                <div class="toggle-label">
                    <label class="toggle-switch">
                        <input type="checkbox" id="inStockFilter" onchange="loadProducts()">
                        <span class="toggle-slider"></span>
                    </label>
                    <span class="toggle-label-text">In Stock Only</span>
                </div>
            </div>

            <button class="reset-btn" onclick="resetFilters()">Reset</button>

        </div>

        <div class="filter-tags" id="filterTags"></div>

        <h2 class="section-heading">Featured Products</h2>

        <div id="productsContainer">
            <partial name="_ProductsGrid" model="Model" />
        </div>
    }
    else
    {
        <div class="empty-state">
            <h3>No Products Found</h3>
            <p>We are currently updating our catalog. Please check back later.</p>
        </div>
    }
</div>

@section Scripts {
    <script>
        let selectedCategories = [];
        let searchTimeout;
        let globalMinPrice = 0;
        let globalMaxPrice = 1000;
        
        const categoryMap = new Map([
            @foreach (var cat in ViewBag.Categories)
            {
                @Html.Raw($"[{cat.Id}, '{cat.Name}'],")
            }
        ]);

        window.addEventListener('load', initPriceSlider);

        function initPriceSlider() {
            fetch('/Home/GetPriceRange')
                .then(r => r.json())
                .then(data => {
                    globalMinPrice = Math.floor(data.min);
                    globalMaxPrice = Math.ceil(data.max);

                    document.getElementById('minPriceSlider').min = globalMinPrice;
                    document.getElementById('minPriceSlider').max = globalMaxPrice;
                    document.getElementById('maxPriceSlider').min = globalMinPrice;
                    document.getElementById('maxPriceSlider').max = globalMaxPrice;
                  
                    document.getElementById('minPriceSlider').value = globalMinPrice;
                    document.getElementById('maxPriceSlider').value = globalMaxPrice;

                    document.getElementById('minPriceDisplay').textContent = '$' + Math.floor(globalMinPrice);
                    document.getElementById('maxPriceDisplay').textContent = '$' + Math.ceil(globalMaxPrice);
                    
                    updateSliderTrack();
                    setupSliderZIndexSwap();
                });
        }

        function setupSliderZIndexSwap() {
            const minSlider = document.getElementById('minPriceSlider');
            const maxSlider = document.getElementById('maxPriceSlider');

            const bringToFront = (active, inactive) => {
                active.style.zIndex = '6';
                inactive.style.zIndex = '5';
            };

            const resetZIndex = () => {
                minSlider.style.zIndex = '6';
                maxSlider.style.zIndex = '5';
            };

            minSlider.addEventListener('mousedown', () => bringToFront(minSlider, maxSlider));
            minSlider.addEventListener('touchstart', () => bringToFront(minSlider, maxSlider));

            maxSlider.addEventListener('mousedown', () => bringToFront(maxSlider, minSlider));
            maxSlider.addEventListener('touchstart', () => bringToFront(maxSlider, minSlider));

            document.addEventListener('mouseup', resetZIndex);
            document.addEventListener('touchend', resetZIndex);
        }

        function debounceSearch() {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(() => loadProducts(), 300);
        }

        function toggleDropdown() {
            const dropdown = document.getElementById('filterDropdown');
            dropdown.classList.toggle('show');
        }

        document.addEventListener('click', function(e) {
            const filterDropdown = document.querySelector('.filter-dropdown');
            if (!filterDropdown.contains(e.target)) {
                document.getElementById('filterDropdown').classList.remove('show');
            }
        });

        function onCategoryChange() {
            const checkboxes = document.querySelectorAll('#filterDropdown input[type="checkbox"]');
            selectedCategories = [];

            checkboxes.forEach(checkbox => {
                if (checkbox.checked) {
                    selectedCategories.push(parseInt(checkbox.value));
                }
            });
            
            renderTags();
            loadProducts();
        }

        function renderTags() {
            const tagsContainer = document.getElementById('filterTags');
            tagsContainer.innerHTML = '';

            selectedCategories.forEach(catId => {
                const categoryName = categoryMap.get(catId);
                const tag = document.createElement('div');
                tag.className = 'filter-tag';
                tag.innerHTML = `
                    ${categoryName}
                    <span class="remove-tag" onclick="removeTag(${catId})">✕</span>
                `;
                tagsContainer.appendChild(tag);
            });
        }

        function removeTag(catId) {
            selectedCategories = selectedCategories.filter(id => id !== catId);
            
            const checkbox = document.querySelector(`#filterDropdown input[value="${catId}"]`);
            if (checkbox) checkbox.checked = false;

            renderTags();
            loadProducts();
        }

        /* NEW LOGIC TO PREVENT CROSSING AND UPDATE DISPLAY */
        function updatePriceDisplay(element) {
            const minSlider = document.getElementById('minPriceSlider');
            const maxSlider = document.getElementById('maxPriceSlider');

            let minVal = parseInt(minSlider.value);
            let maxVal = parseInt(maxSlider.value);

            // Prevent thumbs from crossing
            if (element && element.id === 'minPriceSlider' && minVal >= maxVal) {
                minSlider.value = maxVal - 1;
                minVal = maxVal - 1;
            }
            if (element && element.id === 'maxPriceSlider' && maxVal <= minVal) {
                maxSlider.value = minVal + 1;
                maxVal = minVal + 1;
            }

            document.getElementById('minPriceDisplay').textContent = '$' + minVal;
            document.getElementById('maxPriceDisplay').textContent = '$' + maxVal;

            updateSliderTrack();
        }

        /* NEW LOGIC TO DRAW THE TRACK */
        function updateSliderTrack() {
            const minSlider = document.getElementById('minPriceSlider');
            const maxSlider = document.getElementById('maxPriceSlider');
            const track = document.getElementById('sliderTrack');
            
            const min = parseInt(minSlider.min);
            const max = parseInt(minSlider.max);
            const minVal = parseInt(minSlider.value);
            const maxVal = parseInt(maxSlider.value);
            
            const minPercent = ((minVal - min) / (max - min)) * 100;
            const maxPercent = ((maxVal - min) / (max - min)) * 100;
            
            // Move the track div and scale it!
            track.style.left = minPercent + '%';
            track.style.width = (maxPercent - minPercent) + '%';
        }

        function loadProducts() {
            const categoryIds = selectedCategories.join(',');
            const sortBy = document.getElementById('sortFilter').value || 'default';
            const keyword = document.getElementById('searchInput').value || '';
            const inStock = document.getElementById('inStockFilter').checked;
            
            const minPrice = document.getElementById('minPriceSlider').value;
            const maxPrice = document.getElementById('maxPriceSlider').value;

            fetch(`/Home/FilterAndSort?categoryIds=${categoryIds}&sortBy=${sortBy}&keyword=${encodeURIComponent(keyword)}&inStock=${inStock}&minPrice=${minPrice}&maxPrice=${maxPrice}`)
                .then(response => response.text())
                .then(html => {
                    document.getElementById('productsContainer').innerHTML = html;
                    updatePriceSliderRange();
                })
                .catch(error => console.error('Error:', error));
        }

        function updatePriceSliderRange() {
            fetch('/Home/GetPriceRange')
                .then(r => r.json())
                .then(data => {
                    const newMin = Math.floor(data.min);
                    const newMax = Math.ceil(data.max);

                    document.getElementById('maxPriceSlider').max = newMax > 0 ? newMax : 1000;
                    document.getElementById('minPriceSlider').max = newMax > 0 ? newMax : 1000;
                });
        }

        function resetFilters() {
            selectedCategories = [];
            document.getElementById('searchInput').value = '';
            document.querySelectorAll('#filterDropdown input[type="checkbox"]').forEach(cb => cb.checked = false);
            document.getElementById('sortFilter').value = 'default';
            document.getElementById('inStockFilter').checked = false;
            
            initPriceSlider();

            renderTags();
            loadProducts();
        }
    </script>
}