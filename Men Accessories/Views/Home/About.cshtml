@{
    ViewData["Title"] = "About";
}

<div class="breadcrumb">
    <a asp-controller="Home" asp-action="Index">Home</a>
    <span class="sep">/</span>
    <span class="current">About</span>
</div>

<section style="width:100%; max-width:1200px;">

    <!-- HERO -->
    <div style="
        background:url('/images/about-banner.jpg') center/cover;
        height:340px;
        display:flex;
        align-items:center;
        justify-content:center;
        position:relative;
        margin-bottom:70px;">

        <div style="
            position:absolute;
            inset:0;
            background:rgba(0,0,0,.45);">
        </div>

        <h1 style="
            position:relative;
            color:white;
            font-size:56px;
            letter-spacing:8px;
            font-family:var(--font-display);">
            ABOUT US
        </h1>
    </div>

    <!-- CONTENT -->
    <div style="
        display:grid;
        grid-template-columns:1fr 1fr;
        gap:60px;
        align-items:center;
        margin-bottom:80px;">

        <img src="/images/about-1.jpg"
             style="width:100%; height:500px; object-fit:cover;">

        <div>

            <div class="card-eyebrow">
                OUR STORY
            </div>

            <h2 class="card-title" style="margin-bottom:20px;">
                Fashion With Personality
            </h2>

            <p class="card-sub">
                COZA STORE was created to bring modern fashion,
                luxury accessories, and elegant lifestyle products
                together in one premium experience.
            </p>

            <p class="card-sub">
                We focus on quality, minimal aesthetics,
                and timeless style for customers who
                love modern fashion.
            </p>

            <a class="btn-ghost" href="#">
                SHOP NOW
            </a>

        </div>
    </div>

    <!-- FEATURES -->
    <div style="
        display:grid;
        grid-template-columns:repeat(auto-fit,minmax(240px,1fr));
        gap:24px;
        margin-bottom:60px;">

        <div class="auth-card" style="padding:35px;text-align:center;">
            <h3 style="margin-bottom:15px;">Premium Quality</h3>
            <p class="card-sub">
                Carefully selected products made with high-quality materials.
            </p>
        </div>

        <div class="auth-card" style="padding:35px;text-align:center;">
            <h3 style="margin-bottom:15px;">Fast Delivery</h3>
            <p class="card-sub">
                Secure and fast shipping worldwide.
            </p>
        </div>

        <div class="auth-card" style="padding:35px;text-align:center;">
            <h3 style="margin-bottom:15px;">Modern Style</h3>
            <p class="card-sub">
                Trend-driven collections with timeless elegance.
            </p>
        </div>

    </div>

</section>