@model List<Men_Accessories.Models.Order>
@{
    ViewData["Title"] = "My Orders";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        .orders-page { max-width: 900px; margin: 60px auto 100px; padding: 0 20px; font-family: 'Lato', sans-serif; }
        .orders-heading { text-align: center; margin-bottom: 50px; }
        .orders-heading h1 { font-family: 'Josefin Sans', sans-serif; font-size: 28px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: #111; }
        .orders-heading .line { width: 60px; height: 2px; background: #7a6cf0; margin: 15px auto 0; }
        
        .premium-card {
            background: #fff;
            border: 1px solid #eaeaea;
            border-radius: 8px;
            padding: 25px 30px;
            margin-bottom: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(0,0,0,0.02);
        }
        .premium-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 30px rgba(0,0,0,0.08);
            border-color: #111;
        }

        .card-left { display: flex; flex-direction: column; gap: 12px; }
        
        .status-badge {
            align-self: flex-start;
            font-family: 'Josefin Sans', sans-serif;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            padding: 6px 12px;
            border-radius: 4px;
        }
        .status-paid { background: #eef9f3; color: #2ea76f; border: 1px solid #d4f0e2; }
        .status-processing { background: #f0eeff; color: #7a6cf0; border: 1px solid #dfdaff; }

        .order-number { font-family: 'Josefin Sans', sans-serif; font-size: 20px; color: #111; font-weight: 700; margin: 0; }
        
        .order-details-meta { display: flex; gap: 20px; font-size: 14px; color: #666; }
        .meta-item { display: flex; align-items: center; gap: 6px; }
        .meta-item svg { width: 16px; height: 16px; color: #999; }

        .card-right { text-align: right; display: flex; flex-direction: column; gap: 15px; align-items: flex-end; }
        .total-price { font-family: 'Josefin Sans', sans-serif; font-size: 24px; font-weight: 700; color: #111; }
        
        .btn-outline-dark {
            background: transparent;
            border: 1.5px solid #111;
            color: #111;
            padding: 10px 24px;
            font-family: 'Josefin Sans', sans-serif;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            text-decoration: none;
            border-radius: 4px;
            transition: all 0.3s;
        }
        .btn-outline-dark:hover { background: #111; color: #fff; }

        @@media (max-width: 600px) {
            .premium-card { flex-direction: column; align-items: flex-start; gap: 20px; }
            .card-right { align-items: flex-start; text-align: left; width: 100%; }
            .order-details-meta { flex-direction: column; gap: 10px; }
        }
    </style>
}

<div class="orders-page">
    <div class="orders-heading">
        <h1>Order History</h1>
        <div class="line"></div>
    </div>

    @if (Model != null && Model.Any())
    {
        @foreach (var order in Model)
        {
            <div class="premium-card">
                <div class="card-left">
                    <span class="status-badge @(order.PaymentStatus == "Paid" ? "status-paid" : "status-processing")">
                        @(order.PaymentStatus == "Paid" ? "Payment Successful" : "Processing")
                    </span>
                    <h4 class="order-number">Order #@order.Id</h4>
                    <div class="order-details-meta">
                        <div class="meta-item">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                            @order.CreatedAt.ToString("MMM dd, yyyy")
                        </div>
                        <div class="meta-item">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
                            @order.OrderItems.Count Items
                        </div>
                    </div>
                </div>
                
                <div class="card-right">
                    <div class="total-price">$@order.TotalAmount</div>
                    <a asp-controller="Order" asp-action="Details" asp-route-id="@order.Id" class="btn-outline-dark">View Details</a>
                </div>
            </div>
        }
    }
    else
    {
        <div style="text-align: center; padding: 80px 20px; background: #fff; border: 1px dashed #ccc; border-radius: 8px;">
            <svg style="width:64px;height:64px;color:#ddd;margin-bottom:20px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
            <p style="color: #666; font-size: 16px; margin-bottom: 25px;">You haven't placed any orders yet.</p>
            <a asp-controller="Home" asp-action="Index" style="background:#111;color:#fff;padding:12px 30px;text-decoration:none;font-family:'Josefin Sans', sans-serif;font-weight:700;letter-spacing:2px;text-transform:uppercase;font-size:12px;">Start Shopping</a>
        </div>
    }
</div>