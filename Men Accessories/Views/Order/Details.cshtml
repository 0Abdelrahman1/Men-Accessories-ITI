@model Men_Accessories.Models.Order
@{
    ViewData["Title"] = "Order Details";
    Layout = "~/Views/Shared/_ShopLayout.cshtml";
}

@section Styles {
    <style>
        .receipt-page-container {
            max-width: 900px;
            margin: 0 auto;
            padding: 40px 20px 80px;
            width: 100%;
            animation: fadeUp 0.5s ease both;
        }

        /* =========================================
           BACK LINK
        ========================================= */
        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: var(--primary-text);
            text-decoration: none;
            font-family: var(--font-display);
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            margin-bottom: 24px;
            transition: var(--transition);
        }

        .back-link:hover {
            color: var(--accent);
            transform: translateX(-4px);
        }

        /* =========================================
           RECEIPT CARD
        ========================================= */
        .receipt-card {
            background: var(--white);
            border-radius: 16px;
            box-shadow: var(--shadow-md);
            border: 1px solid var(--gray-light);
            overflow: hidden;
        }

        /* Header */
        .receipt-header {
            background: var(--gray-light);
            border-bottom: 1px solid var(--gray-mid);
            padding: 32px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .receipt-header h2 {
            margin: 0 0 8px 0;
            font-family: var(--font-display);
            font-size: 24px;
            font-weight: 700;
            color: var(--primary-dark);
            letter-spacing: 1px;
        }

        .receipt-header p {
            margin: 0;
            font-size: 14px;
            color: var(--primary-text);
        }

        .receipt-status {
            text-align: right;
        }

        .badge {
            display: inline-block;
            padding: 8px 16px;
            border-radius: 8px;
            font-family: var(--font-display);
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;
        }

        .badge-success {
            background: rgba(16, 185, 129, 0.1);
            color: var(--success);
            border: 1px solid rgba(16, 185, 129, 0.2);
        }

        /* Body & Table */
        .receipt-body {
            padding: 40px;
        }

        .product-table {
            width: 100%;
            border-collapse: collapse;
        }

        .product-table th {
            text-align: left;
            padding-bottom: 16px;
            border-bottom: 2px solid var(--gray-mid);
            font-family: var(--font-display);
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: var(--primary-dark);
        }

        .product-table td {
            padding: 24px 0;
            border-bottom: 1px solid var(--gray-light);
            vertical-align: middle;
        }

        .product-table tr:last-child td {
            border-bottom: none;
            padding-bottom: 0;
        }

        .prod-info {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .prod-img {
            width: 70px;
            height: 70px;
            object-fit: cover;
            border-radius: 8px;
            border: 1px solid var(--gray-mid);
            box-shadow: var(--shadow-sm);
        }

        .prod-name {
            font-weight: 700;
            font-family: var(--font-display);
            font-size: 16px;
            color: var(--primary-dark);
            margin: 0;
        }

        .td-price, .td-qty {
            color: var(--primary-text);
            font-size: 15px;
        }

        .td-total {
            font-weight: 700;
            color: var(--primary-dark);
            font-size: 16px;
            text-align: right;
        }

        /* Footer */
        .receipt-footer {
            background: linear-gradient(135deg, var(--primary-dark) 0%, #1E293B 100%);
            color: var(--white);
            padding: 32px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .footer-label {
            font-family: var(--font-display);
            font-size: 12px;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--gray-mid);
            margin-bottom: 8px;
            display: block;
        }

        .payment-method {
            font-size: 15px;
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 600;
        }

        .grand-total {
            font-family: var(--font-display);
            font-size: 36px;
            font-weight: 700;
            color: var(--white);
            margin: 0;
        }

        @@keyframes fadeUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @@media (max-width: 600px) {
            .receipt-header, .receipt-body, .receipt-footer { padding: 24px; }
            .receipt-header, .receipt-footer { flex-direction: column; align-items: flex-start; gap: 16px; }
            .receipt-status, .receipt-footer > div:last-child { text-align: left; }
            .product-table th:nth-child(2), .product-table td:nth-child(2) { display: none; } /* Hide Unit Price on mobile */
        }
    </style>
}

<div class="receipt-page-container">
    
    <a asp-action="MyOrders" class="back-link">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        Back to Order History
    </a>

    <div class="receipt-card">
        
        <div class="receipt-header">
            <div>
                <h2>Order #@Model.Id</h2>
                <p>Placed on @Model.CreatedAt.ToString("MMMM dd, yyyy 'at' hh:mm tt")</p>
            </div>
            <div class="receipt-status">
                <span class="badge @(Model.PaymentStatus == "Paid" ? "badge-success" : "")">
                    @Model.PaymentStatus
                </span>
            </div>
        </div>

        <div class="receipt-body">
            <table class="product-table">
                <thead>
                    <tr>
                        <th>Item Description</th>
                        <th>Price</th>
                        <th>Qty</th>
                        <th style="text-align: right;">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.OrderItems)
                    {
                        <tr>
                            <td>
                                <div class="prod-info">
                                    <img src="@item.Product.ImageUrl" alt="@item.Product.Name" class="prod-img" onerror="this.src='/images/placeholder.jpg'" />
                                    <p class="prod-name">@item.Product.Name</p>
                                </div>
                            </td>
                            <td class="td-price">$@item.UnitPrice.ToString("0.00")</td>
                            <td class="td-qty">x @item.Quantity</td>
                            <td class="td-total">$@((item.UnitPrice * item.Quantity).ToString("0.00"))</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="receipt-footer">
            <div>
                <span class="footer-label">Payment Method</span>
                <div class="payment-method">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2">
                        <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
                        <line x1="1" y1="10" x2="23" y2="10"></line>
                    </svg>
                    Stripe Secure Checkout
                </div>
            </div>
            <div style="text-align: right;">
                <span class="footer-label">Total Amount Paid</span>
                <p class="grand-total">$@Model.TotalAmount.ToString("0.00")</p>
            </div>
        </div>

    </div>
</div>