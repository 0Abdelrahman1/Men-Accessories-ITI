@model Men_Accessories.Models.Order
@{
    ViewData["Title"] = "Order Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        .receipt-container { max-width: 800px; margin: 40px auto 100px; padding: 0 20px; font-family: 'Lato', sans-serif; }
        
        .back-link { display: inline-flex; align-items: center; gap: 8px; color: #666; text-decoration: none; font-family: 'Josefin Sans', sans-serif; font-size: 12px; letter-spacing: 1px; text-transform: uppercase; margin-bottom: 30px; transition: color 0.3s; }
        .back-link:hover { color: #111; }
        
        .receipt-box { background: #fff; border: 1px solid #eaeaea; border-radius: 8px; overflow: hidden; box-shadow: 0 10px 40px rgba(0,0,0,0.03); }
        
        .receipt-header { background: #f8f9fa; border-bottom: 1px solid #eaeaea; padding: 30px 40px; display: flex; justify-content: space-between; align-items: center; }
        .receipt-header h2 { margin: 0; font-family: 'Josefin Sans', sans-serif; font-size: 22px; font-weight: 700; color: #111; }
        .receipt-header p { margin: 5px 0 0; font-size: 13px; color: #777; }
        
        .receipt-status { text-align: right; }
        .badge { display: inline-block; padding: 6px 12px; border-radius: 4px; font-family: 'Josefin Sans', sans-serif; font-size: 10px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; }
        .badge-success { background: #eef9f3; color: #2ea76f; border: 1px solid #d4f0e2; }
        
        .receipt-body { padding: 30px 40px; }
        
        .product-table { width: 100%; border-collapse: collapse; }
        .product-table th { text-align: left; padding-bottom: 15px; border-bottom: 2px solid #111; font-family: 'Josefin Sans', sans-serif; font-size: 11px; letter-spacing: 2px; text-transform: uppercase; color: #666; }
        .product-table td { padding: 20px 0; border-bottom: 1px solid #eaeaea; vertical-align: middle; }
        
        .prod-info { display: flex; align-items: center; gap: 15px; }
        .prod-img { width: 60px; height: 60px; object-fit: cover; border-radius: 6px; border: 1px solid #eaeaea; }
        .prod-name { font-weight: 600; color: #111; font-size: 15px; margin: 0; }
        
        .td-price, .td-qty { color: #666; font-size: 14px; }
        .td-total { font-weight: 700; color: #111; font-size: 15px; text-align: right; }
        
        .receipt-footer { background: #111; color: #fff; padding: 30px 40px; display: flex; justify-content: space-between; align-items: center; }
        .footer-label { font-family: 'Josefin Sans', sans-serif; font-size: 12px; letter-spacing: 2px; text-transform: uppercase; color: #aaa; margin-bottom: 5px; display: block; }
        .grand-total { font-family: 'Josefin Sans', sans-serif; font-size: 32px; font-weight: 700; color: #fff; margin: 0; }
    </style>
}

<div class="receipt-container">
    <a asp-action="MyOrders" class="back-link">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
        Back to Order History
    </a>

    <div class="receipt-box">
        <div class="receipt-header">
            <div>
                <h2>Order #@Model.Id</h2>
                <p>Placed on @Model.CreatedAt.ToString("MMMM dd, yyyy 'at' hh:mm tt")</p>
            </div>
            <div class="receipt-status">
                <span class="badge @(Model.PaymentStatus == "Paid" ? "badge-success" : "")">
                    @Model.PaymentStatus
                </span>
            </div>
        </div>

        <div class="receipt-body">
            <table class="product-table">
                <thead>
                    <tr>
                        <th>Item Description</th>
                        <th>Price</th>
                        <th>Qty</th>
                        <th style="text-align: right;">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.OrderItems)
                    {
                        <tr>
                            <td>
                                <div class="prod-info">
                                    <img src="@item.Product.ImageUrl" alt="@item.Product.Name" class="prod-img" onerror="this.src='/images/placeholder.jpg'" />
                                    <p class="prod-name">@item.Product.Name</p>
                                </div>
                            </td>
                            <td class="td-price">$@item.UnitPrice</td>
                            <td class="td-qty">x @item.Quantity</td>
                            <td class="td-total">$@(item.UnitPrice * item.Quantity)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="receipt-footer">
            <div>
                <span class="footer-label">Payment Method</span>
                <div style="font-size: 15px; display: flex; align-items: center; gap: 8px;">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
                    Stripe Secure Checkout
                </div>
            </div>
            <div style="text-align: right;">
                <span class="footer-label">Total Amount Paid</span>
                <p class="grand-total">$@Model.TotalAmount</p>
            </div>
        </div>
    </div>
</div>