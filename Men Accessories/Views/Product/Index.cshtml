@model ProductPaginationViewModel
@{
    ViewData["Title"] = "Manage Products";
    Layout = "~/Views/Shared/_ShopLayout.cshtml";
}

@section Styles {
    <style>
        .admin-page-container {
            max-width: 1200px;
            margin: 0 auto;
            width: 100%;
            padding-bottom: 60px;
        }

        /* =========================================
           PAGE HEADER
        ========================================= */
        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 40px;
            padding: 40px;
            background: linear-gradient(135deg, var(--primary-dark) 0%, #1E293B 100%);
            border-radius: 16px;
            box-shadow: var(--shadow-md);
            color: var(--white);
            animation: fadeUp 0.4s ease both;
        }

        .page-title {
            font-family: var(--font-display);
            font-size: 28px;
            font-weight: 700;
            letter-spacing: 3px;
            text-transform: uppercase;
            margin: 0;
        }

        .btn-add-new {
            background: var(--accent);
            color: var(--white);
            font-family: var(--font-display);
            font-size: 13px;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            padding: 14px 28px;
            border-radius: 8px;
            text-decoration: none;
            transition: var(--transition);
            border: 2px solid var(--accent);
            display: inline-block;
        }

        .btn-add-new:hover {
            background: transparent;
            color: var(--white);
            transform: translateY(-2px);
        }

        /* =========================================
           TABLE STYLES
        ========================================= */
        .table-wrapper {
            background: var(--white);
            border: 1px solid var(--gray-mid);
            border-radius: 16px;
            overflow: hidden; /* Keeps the rounded corners with the table inside */
            box-shadow: var(--shadow-sm);
            animation: fadeUp 0.6s ease both;
        }

        .admin-table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
        }

        .admin-table th {
            background: var(--gray-light);
            font-family: var(--font-display);
            font-size: 12px;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            padding: 20px 24px;
            border-bottom: 1px solid var(--gray-mid);
            color: var(--primary-dark);
            font-weight: 700;
        }

        .admin-table td {
            padding: 16px 24px;
            border-bottom: 1px solid var(--gray-mid);
            vertical-align: middle;
            font-size: 14px;
            color: var(--primary-text);
            transition: var(--transition);
        }

        .admin-table tr:last-child td {
            border-bottom: none;
        }

        .admin-table tr:hover td {
            background: var(--gray-light);
        }

        /* =========================================
           TABLE CONTENT
        ========================================= */
        .prod-img {
            width: 60px;
            height: 60px;
            object-fit: cover;
            border-radius: 8px;
            box-shadow: var(--shadow-sm);
            border: 1px solid var(--gray-mid);
            transition: var(--transition);
        }
        
        .admin-table tr:hover .prod-img {
            transform: scale(1.05);
        }

        .prod-name {
            color: var(--primary-dark);
            font-weight: 700;
            text-decoration: none;
            font-size: 15px;
            transition: var(--transition);
        }
        
        .prod-name:hover {
            color: var(--accent);
        }

        .price-text {
            color: var(--primary-dark);
            font-weight: 700;
            font-family: var(--font-body);
            font-size: 15px;
        }

        /* Status Badges */
        .badge {
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 0.5px;
            display: inline-block;
            font-family: var(--font-body);
        }
        .badge-success {
            background: rgba(16, 185, 129, 0.1);
            color: var(--success);
        }
        .badge-error {
            background: rgba(239, 68, 68, 0.1);
            color: var(--error);
        }

        /* =========================================
           ACTION BUTTONS
        ========================================= */
        .action-links {
            display: flex;
            gap: 10px;
        }

        .btn-action {
            padding: 8px 16px;
            border-radius: 6px;
            font-family: var(--font-display);
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            text-decoration: none;
            transition: var(--transition);
        }

        .btn-edit { background: rgba(245, 158, 11, 0.1); color: var(--warning); }
        .btn-edit:hover { background: var(--warning); color: var(--white); box-shadow: var(--shadow-sm); }
        
        .btn-details { background: rgba(79, 70, 229, 0.1); color: var(--accent); }
        .btn-details:hover { background: var(--accent); color: var(--white); box-shadow: var(--shadow-sm); }
        
        .btn-delete { background: rgba(239, 68, 68, 0.1); color: var(--error); }
        .btn-delete:hover { background: var(--error); color: var(--white); box-shadow: var(--shadow-sm); }

        /* =========================================
           EMPTY STATE
        ========================================= */
        .empty-state {
            text-align: center;
            padding: 80px 20px;
            background: var(--white);
            border: 2px dashed var(--gray-mid);
            border-radius: 16px;
            color: var(--primary-text);
            animation: fadeUp 0.5s ease both;
        }
        
        .empty-state h3 {
            font-family: var(--font-display);
            font-size: 24px;
            color: var(--primary-dark);
            letter-spacing: 1.5px;
            margin-bottom: 12px;
        }

        @@keyframes fadeUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
}

<div class="admin-page-container">
    <div class="page-header">
        <h1 class="page-title">Products Inventory</h1>
        <a asp-action="Create" class="btn-add-new">+ Add New Product</a>
    </div>

    @if (Model != null && Model.Products.Count > 0)
    {
        <div class="table-wrapper">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Image</th>
                        <th>Name</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Stock</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model.Products)
                    {
                        <tr>
                            <td>
                                <img src="@product.ImageUrl" alt="@product.Name" class="prod-img" onerror="this.src='/images/placeholder.jpg'" />
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@product.Id" class="prod-name">@product.Name</a>
                            </td>
                            <td>@(product.Category?.Name ?? "General")</td>
                            <td class="price-text">$@product.Price</td>
                            <td>
                                @if (product.StockQuantity > 0)
                                {
                                    <span class="badge badge-success">@product.StockQuantity in stock</span>
                                }
                                else
                                {
                                    <span class="badge badge-error">Out of Stock</span>
                                }
                            </td>
                            <td>
                                <div class="action-links">
                                    <a asp-action="Edit" asp-route-id="@product.Id" class="btn-action btn-edit">Edit</a>
                                    <a asp-action="Details" asp-route-id="@product.Id" class="btn-action btn-details">View</a>
                                    <a asp-action="Delete" asp-route-id="@product.Id" class="btn-action btn-delete">Delete</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <h3>No Products Found</h3>
            <p>Your inventory is currently empty. Start building your store by adding a new product.</p>
        </div>
    }
</div>

@if (Model.TotalPages > 1)
{
    <div style="margin-top:20px; text-align:center;">
        @if (Model.CurrentPage > 1)
        {
            <a class="btn-card" href="@Url.Action("Index", new { page = Model.CurrentPage - 1 })">
                Prev
            </a>
        }

        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <a class="btn-card"
               style="@(i == Model.CurrentPage ? "background:black;color:white;" : "")"
               href="@Url.Action("Index", new { page = i })">

                @i
            </a>
        }

        @if (Model.CurrentPage < Model.TotalPages)
        {
            <a class="btn-card" href="@Url.Action("Index", new { page = Model.CurrentPage + 1 })">
                Next
            </a>
        }
    </div>
}