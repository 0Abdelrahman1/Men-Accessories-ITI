@model Men_Accessories.Models.Product

@{
    ViewData["Title"] = Model.Name;
    Layout = "~/Views/Shared/_ShopLayout.cshtml";

    decimal finalPrice = Model.Price;
    decimal oldPrice = 0;
    if (Model.Discount > 0)
    {
        finalPrice = Model.Price - (Model.Price * (Model.Discount / 100));
        oldPrice = Model.Price;
    }
}

@section Styles {
    <style>
        .detail-container {
            max-width: 1200px;
            margin: 0 auto;
            width: 100%;
            padding: 40px 20px;
            animation: fadeUp 0.5s ease both;
        }

        /* =========================================
           BREADCRUMB
        ========================================= */
        .breadcrumb {
            font-family: var(--font-display);
            font-size: 12px;
            letter-spacing: 2px;
            color: var(--primary-text);
            text-transform: uppercase;
            margin-bottom: 40px;
            display: flex;
            gap: 12px;
            align-items: center;
            font-weight: 600;
        }

        .breadcrumb a {
            color: var(--primary-text);
            text-decoration: none;
            transition: var(--transition);
        }

        .breadcrumb a:hover {
            color: var(--accent);
        }

        .breadcrumb .sep {
            color: var(--gray-mid);
        }

        .breadcrumb .current {
            color: var(--accent);
            font-weight: 700;
        }

        /* =========================================
           PRODUCT GRID & IMAGE
        ========================================= */
        .product-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 60px;
            align-items: start;
        }

        .img-box {
            background: var(--white);
            border: 1px solid var(--gray-light);
            border-radius: 16px;
            position: relative;
            overflow: hidden;
            width: 100%;
            aspect-ratio: 4 / 5;
            max-height: 600px;
            box-shadow: var(--shadow-md);
        }

        .img-box img {
            width: 100%;
            height: 100%; 
            display: block;
            object-fit: cover; 
            object-position: center; 
            transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .img-box:hover img {
            transform: scale(1.05);
        }

        .badge-sale {
            position: absolute;
            top: 24px;
            left: 24px;
            background: var(--error);
            color: var(--white);
            font-family: var(--font-display);
            font-size: 13px;
            font-weight: 700;
            letter-spacing: 2px;
            padding: 8px 16px;
            border-radius: 8px;
            box-shadow: var(--shadow-sm);
            z-index: 2;
        }

        .featured-badge {
            position: absolute;
            top: 24px;
            right: 24px;
            background: rgba(16, 185, 129, 0.9);
            color: var(--white);
            font-family: var(--font-display);
            font-size: 13px;
            font-weight: 700;
            letter-spacing: 2px;
            padding: 8px 16px;
            border-radius: 8px;
            box-shadow: var(--shadow-sm);
            z-index: 2;
        }

        /* =========================================
           PRODUCT INFO
        ========================================= */
        .info-box {
            display: flex;
            flex-direction: column;
            padding: 20px 0;
        }

        .product-cat {
            font-family: var(--font-display);
            font-size: 12px;
            letter-spacing: 3px;
            color: var(--accent);
            text-transform: uppercase;
            margin-bottom: 16px;
            font-weight: 700;
        }

        .product-title {
            font-family: var(--font-display);
            font-size: 40px;
            font-weight: 700;
            color: var(--primary-dark);
            margin-bottom: 24px;
            line-height: 1.2;
            letter-spacing: 1px;
        }

        /* =========================================
           PRICE
        ========================================= */
        .price-wrap {
            display: flex;
            align-items: center;
            gap: 16px;
            margin-bottom: 32px;
            font-family: var(--font-body);
        }

        .price-current {
            font-size: 36px;
            font-weight: 700;
            color: var(--primary-dark);
        }

        .price-old {
            font-size: 20px;
            color: #94A3B8; /* Slate 400 */
            text-decoration: line-through;
            font-weight: 400;
        }

        /* =========================================
           DESCRIPTION & STOCK
        ========================================= */
        .product-desc {
            font-family: var(--font-body);
            font-size: 16px;
            color: var(--primary-text);
            line-height: 1.8;
            margin-bottom: 40px;
            padding-bottom: 40px;
            border-bottom: 1px solid var(--gray-mid);
        }

        .stock-info {
            font-family: var(--font-display);
            font-size: 13px;
            letter-spacing: 2px;
            color: var(--primary-dark);
            margin-bottom: 36px;
            display: flex;
            align-items: center;
            gap: 12px;
            text-transform: uppercase;
            font-weight: 700;
        }

        .stock-badge {
            padding: 6px 16px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 700;
            letter-spacing: 1px;
        }

        .stock-badge.in-stock {
            background: rgba(16, 185, 129, 0.1);
            color: var(--success);
        }

        .stock-badge.out-of-stock {
            background: rgba(239, 68, 68, 0.1);
            color: var(--error);
        }

        /* =========================================
           ACTION BUTTONS
        ========================================= */
        .action-wrap {
            display: flex;
            gap: 16px;
        }

        .btn-add {
            flex: 1;
            background: var(--primary-dark);
            color: var(--white);
            font-family: var(--font-display);
            font-size: 14px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            padding: 20px;
            border: none;
            border-radius: 12px;
            cursor: pointer;
            transition: var(--transition);
            text-align: center;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

        .btn-add:hover {
            background: var(--accent);
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
        }

        .btn-back {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px 32px;
            border: 2px solid var(--gray-mid);
            background: var(--white);
            color: var(--primary-dark);
            font-family: var(--font-display);
            font-size: 14px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            border-radius: 12px;
            cursor: pointer;
            transition: var(--transition);
            text-decoration: none;
        }

        .btn-back:hover {
            border-color: var(--primary-dark);
            background: var(--gray-light);
        }

        @@keyframes fadeUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @@media (max-width: 992px) {
            .product-grid { grid-template-columns: 1fr; gap: 40px; }
            .img-box { max-height: 500px; }
        }

        @@media (max-width: 540px) {
            .action-wrap { flex-direction: column; }
            .product-title { font-size: 32px; }
            .price-current { font-size: 32px; }
        }
    </style>
}

<div class="detail-container">
    <div class="breadcrumb">
        <a asp-controller="Home" asp-action="Index">Home</a>
        <span class="sep">/</span>
        <a href="#">@(Model.Category?.Name ?? "Shop")</a>
        <span class="sep">/</span>
        <span class="current">@Model.Name</span>
    </div>

    <div class="product-grid">
        <div class="img-box">
            <img src="@Model.ImageUrl" alt="@Model.Name" onerror="this.src='/images/placeholder.jpg'" />
            @if (Model.Discount > 0)
            {
                <span class="badge-sale">-@Model.Discount.ToString("0")%</span>
            }
            @if (Model.IsFeatured)
            {
                <div class="featured-badge">
                    <span class="badge-featured">⭐ Featured Product</span>
                </div>
            }
        </div>

        <div class="info-box">
            <span class="product-cat">@(Model.Category?.Name ?? "General")</span>
            <h1 class="product-title">@Model.Name</h1>

            <div class="price-wrap">
                <span class="price-current">$@finalPrice.ToString("0.00")</span>
                @if (Model.Discount > 0)
                {
                    <span class="price-old">$@oldPrice.ToString("0.00")</span>
                }
            </div>

            <p class="product-desc">
                @Model.Description
            </p>

            <div class="stock-info">
                Availability:
                @if (Model.StockQuantity > 0)
                {
                    <span class="stock-badge in-stock">In Stock (@Model.StockQuantity)</span>
                }
                else
                {
                    <span class="stock-badge out-of-stock">Out of Stock</span>
                }
            </div>

            <div class="action-wrap">
                @if (Model.StockQuantity > 0)
                {
                    <form id="addToCartForm" asp-controller="Cart" asp-action="AddToCartAjax" method="post" style="flex: 1;">
                        <input type="hidden" name="productId" value="@Model.Id" />
                        <input type="hidden" name="quantity" value="1" />
                        <button type="submit" class="btn-add">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
                                <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"></path>
                                <line x1="3" y1="6" x2="21" y2="6"></line>
                                <path d="M16 10a4 4 0 01-8 0"></path>
                            </svg>
                            Add to Cart
                        </button>
                    </form>
                }
                <a asp-controller="Home" asp-action="Index" class="btn-back">Back to Shop</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <script>
        document.getElementById('addToCartForm').addEventListener('submit', function (e) {
            e.preventDefault(); 

            var form = this;
            var formData = new FormData(form);

            fetch(form.action, {
                method: 'POST',
                body: formData
            })
            .then(response => response.json()) 
            .then(data => {
                if (data.success) {
                    Swal.fire({
                        title: 'Success!',
                        text: data.message,
                        icon: 'success',
                        toast: true,
                        position: 'top-end',
                        showConfirmButton: false,
                        timer: 3000,
                        timerProgressBar: true,
                        background: 'var(--white)',
                        color: 'var(--primary-dark)',
                        iconColor: 'var(--success)'
                    });
                } else {
                    Swal.fire({
                        title: 'Oops...', 
                        text: data.message, 
                        icon: 'error',
                        confirmButtonColor: 'var(--primary-dark)'
                    });
                }
            })
            .catch(error => {
                Swal.fire({
                    title: 'Error', 
                    text: 'Could not connect to the server.', 
                    icon: 'error',
                    confirmButtonColor: 'var(--primary-dark)'
                });
            });
        });
    </script>
}