@model Men_Accessories.Models.Product
@{
    ViewData["Title"] = "Delete Product";
    Layout = "~/Views/Shared/_ShopLayout.cshtml";
}

@section Styles {
    <style>
        .delete-page-container {
            display: flex;
            justify-content: center;
            padding: 60px 20px;
            width: 100%;
        }

        /* =========================================
           DELETE CARD
        ========================================= */
        .delete-card {
            background: var(--white);
            width: 100%;
            max-width: 600px;
            padding: 48px 40px;
            border-radius: 16px;
            box-shadow: var(--shadow-md);
            border: 1px solid rgba(239, 68, 68, 0.2);
            border-top: 6px solid var(--error);
            animation: fadeUp 0.5s ease both;
            text-align: center;
        }

        .icon-circle {
            width: 72px;
            height: 72px;
            background: rgba(239, 68, 68, 0.1);
            color: var(--error);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 24px;
        }

        .icon-circle svg {
            width: 36px;
            height: 36px;
        }

        .delete-title {
            font-family: var(--font-display);
            font-size: 26px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--primary-dark);
            margin-bottom: 12px;
        }

        .delete-subtitle {
            color: var(--primary-text);
            font-size: 15px;
            margin-bottom: 32px;
            line-height: 1.6;
        }

        /* =========================================
           PRODUCT PREVIEW
        ========================================= */
        .product-preview {
            background: var(--gray-light);
            padding: 24px;
            border-radius: 12px;
            margin-bottom: 36px;
            display: flex;
            align-items: center;
            gap: 24px;
            text-align: left;
            border: 1px solid var(--gray-mid);
        }

        .product-preview img {
            width: 80px;
            height: 80px;
            object-fit: cover;
            border-radius: 8px;
            border: 1px solid var(--gray-mid);
            box-shadow: var(--shadow-sm);
        }

        .product-details h4 {
            font-family: var(--font-display);
            font-size: 18px;
            color: var(--primary-dark);
            margin-bottom: 8px;
            font-weight: 700;
        }

        .product-details p {
            font-size: 14px;
            color: var(--primary-text);
            margin: 0 0 6px 0;
        }
        
        .product-details p strong {
            color: var(--primary-dark);
        }

        /* =========================================
           BUTTONS
        ========================================= */
        .btn-delete {
            width: 100%;
            background: var(--error);
            color: var(--white);
            font-family: var(--font-display);
            font-size: 14px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            padding: 16px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            transition: var(--transition);
        }

        .btn-delete:hover {
            background: #DC2626; /* Darker red */
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(239, 68, 68, 0.3);
        }

        .back-link {
            display: block;
            text-align: center;
            margin-top: 20px;
            font-family: var(--font-display);
            font-size: 12px;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--primary-text);
            text-decoration: none;
            font-weight: 600;
            transition: var(--transition);
        }

        .back-link:hover {
            color: var(--primary-dark);
            text-decoration: underline;
        }

        @@keyframes fadeUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @@media (max-width: 540px) {
            .delete-card { padding: 32px 24px; }
            .product-preview { flex-direction: column; text-align: center; }
        }
    </style>
}

<div class="delete-page-container">
    <div class="delete-card">
        
        <div class="icon-circle">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                <line x1="12" y1="9" x2="12" y2="13"></line>
                <line x1="12" y1="17" x2="12.01" y2="17"></line>
            </svg>
        </div>
        
        <h1 class="delete-title">Are you absolutely sure?</h1>
        <p class="delete-subtitle">This action cannot be undone. This will permanently remove the product from your store's database.</p>

        <div class="product-preview">
            <img src="@Model.ImageUrl" alt="@Model.Name" onerror="this.src='/images/placeholder.jpg'" />
            <div class="product-details">
                <h4>@Model.Name</h4>
                <p><strong>Price:</strong> $@Model.Price</p>
                <p><strong>Stock:</strong> @Model.StockQuantity</p>
                <p><strong>Category:</strong> @(Model.Category?.Name ?? "General")</p>
            </div>
        </div>

        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            
            <button type="submit" class="btn-delete">Yes, Delete Product</button>
            <a asp-action="Index" class="back-link">Cancel & Keep Product</a>
        </form>
        
    </div>
</div>