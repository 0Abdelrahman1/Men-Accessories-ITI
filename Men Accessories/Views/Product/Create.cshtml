@model Men_Accessories.Models.Product
@{
    ViewData["Title"] = "Add New Product";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        .form-page-container {
            display: flex;
            justify-content: center;
            padding: 40px 20px 80px;
        }

        .form-card {
            background: var(--white);
            width: 100%;
            max-width: 700px;
            padding: 40px 50px;
            box-shadow: 0 8px 40px rgba(0,0,0,0.05);
            border: 1px solid var(--gray-mid);
            animation: fadeUp 0.5s ease both;
        }

        .form-header {
            margin-bottom: 30px;
            text-align: center;
        }

        .form-title {
            font-family: var(--font-display);
            font-size: 28px;
            font-weight: 700;
            letter-spacing: 3px;
            text-transform: uppercase;
            color: var(--black);
        }

        .form-group {
            margin-bottom: 24px;
        }

        .form-label {
            display: block;
            font-family: var(--font-display);
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--black);
            margin-bottom: 8px;
        }

        .form-control {
            width: 100%;
            border: 1.5px solid var(--gray-mid);
            padding: 14px 16px;
            font-family: var(--font-body);
            font-size: 14px;
            color: var(--black);
            background: var(--gray-light);
            outline: none;
            transition: border-color 0.3s, background 0.3s;
        }

            .form-control:focus {
                border-color: var(--accent);
                background: var(--white);
            }

        .text-danger {
            font-size: 12px;
            color: var(--error);
            margin-top: 5px;
            display: block;
        }

        .btn-submit {
            width: 100%;
            background: var(--black);
            color: var(--white);
            font-family: var(--font-display);
            font-size: 14px;
            font-weight: 700;
            letter-spacing: 3px;
            text-transform: uppercase;
            padding: 16px;
            border: 2px solid var(--black);
            cursor: pointer;
            transition: all 0.3s ease;
            margin-top: 10px;
        }

            .btn-submit:hover {
                background: var(--white);
                color: var(--black);
            }

        .back-link {
            display: block;
            text-align: center;
            margin-top: 20px;
            font-family: var(--font-display);
            font-size: 12px;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--gray-text);
            text-decoration: none;
        }

            .back-link:hover {
                color: var(--accent);
            }

        .grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }
    </style>
}

<div class="form-page-container">
    <div class="form-card">
        <div class="form-header">
            <h1 class="form-title">Add New Product</h1>
        </div>

        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Name" class="form-label">Product Name</label>
                <input asp-for="Name" class="form-control" placeholder="e.g. Classic Leather Watch" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description" class="form-label">Description</label>
                <textarea asp-for="Description" class="form-control" rows="4" placeholder="Enter product details..."></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ImageUrl" class="form-label">Image URL</label>
                <input asp-for="ImageUrl" class="form-control" placeholder="https://example.com/image.jpg" />
                <span asp-validation-for="ImageUrl" class="text-danger"></span>
            </div>

            <div class="grid-2">
                <div class="form-group">
                    <label asp-for="Price" class="form-label">Price ($)</label>
                    <input asp-for="Price" type="number" step="0.01" class="form-control" placeholder="0.00" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="StockQuantity" class="form-label">Stock Quantity</label>
                    <input asp-for="StockQuantity" type="number" class="form-control" placeholder="0" />
                    <span asp-validation-for="StockQuantity" class="text-danger"></span>
                </div>
            </div>

            <div class="grid-2">
                <div class="form-group">
                    <label asp-for="Discount" class="form-label">Discount (%)</label>
                    <input asp-for="Discount" type="number" step="0.01" class="form-control" placeholder="0" />
                    <span asp-validation-for="Discount" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="CategoryId" class="form-label">Category ID</label>
                    <input asp-for="CategoryId" type="number" class="form-control" placeholder="e.g. 1" />
                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                </div>
            </div>

            <button type="submit" class="btn-submit">Save Product</button>
            <a asp-action="Index" class="back-link">Cancel & Back to Inventory</a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}