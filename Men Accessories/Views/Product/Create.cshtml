@model Men_Accessories.Models.Product
@{
    ViewData["Title"] = "Add New Product";
    Layout = "~/Views/Shared/_ShopLayout.cshtml";
}

@section Styles {
    <style>
        .form-page-container {
            display: flex;
            justify-content: center;
            padding: 40px 20px 80px;
            width: 100%;
        }

        .form-card {
            background: var(--white);
            width: 100%;
            max-width: 760px;
            padding: 48px;
            border-radius: 16px;
            box-shadow: var(--shadow-md);
            border: 1px solid var(--gray-light);
            animation: fadeUp 0.5s ease both;
        }

        .form-header {
            margin-bottom: 40px;
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .icon-circle {
            width: 64px;
            height: 64px;
            background: rgba(79, 70, 229, 0.1);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 16px;
            color: var(--accent);
        }

        .form-title {
            font-family: var(--font-display);
            font-size: 28px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--primary-dark);
            margin: 0;
        }

        .form-group {
            margin-bottom: 24px;
        }

        .form-label {
            display: block;
            font-family: var(--font-display);
            font-size: 13px;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: var(--primary-dark);
            margin-bottom: 8px;
        }

        .form-control {
            width: 100%;
            border: 1.5px solid var(--gray-mid);
            padding: 14px 16px;
            font-family: var(--font-body);
            font-size: 14px;
            color: var(--primary-dark);
            background: var(--gray-light);
            border-radius: 8px;
            outline: none;
            transition: var(--transition);
        }

        .form-control:focus {
            border-color: var(--accent);
            background: var(--white);
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);
        }

        .form-control::placeholder {
            color: #A0AEC0;
        }

        .text-danger {
            font-size: 12px;
            color: var(--error);
            margin-top: 6px;
            display: block;
            font-weight: 600;
        }

        .validation-summary-errors {
            background: rgba(239, 68, 68, 0.1);
            padding: 16px;
            border-radius: 8px;
            margin-bottom: 24px;
            border-left: 4px solid var(--error);
        }
        
        .validation-summary-errors ul {
            list-style: none;
            margin: 0;
            padding: 0;
        }
        
        .validation-summary-errors li {
            font-size: 13px;
            color: var(--error);
            font-weight: 600;
        }

        /* =========================================
           LAYOUT & BUTTONS
        ========================================= */
        .grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        .btn-submit {
            width: 100%;
            background: var(--primary-dark);
            color: var(--white);
            font-family: var(--font-display);
            font-size: 14px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            padding: 16px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            transition: var(--transition);
            margin-top: 16px;
        }

        .btn-submit:hover {
            background: var(--accent);
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
        }

        .back-link {
            display: block;
            text-align: center;
            margin-top: 24px;
            font-family: var(--font-display);
            font-size: 12px;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--primary-text);
            text-decoration: none;
            font-weight: 600;
            transition: var(--transition);
        }

        .back-link:hover {
            color: var(--accent);
        }

        /* NEW: Image URL section styles */
        .image-urls-section {
            background: rgba(79, 70, 229, 0.05);
            border: 1px solid rgba(79, 70, 229, 0.2);
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 24px;
        }

        .image-urls-title {
            font-family: var(--font-display);
            font-size: 12px;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--accent);
            font-weight: 700;
            margin-bottom: 16px;
            display: block;
        }

        .add-image-url-btn {
            background: var(--accent);
            color: white;
            border: none;
            padding: 10px 16px;
            border-radius: 6px;
            font-family: var(--font-display);
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            cursor: pointer;
            transition: var(--transition);
            margin-top: 12px;
        }

        .add-image-url-btn:hover {
            background: var(--primary-dark);
        }

        .image-url-input-group {
            display: flex;
            gap: 8px;
            margin-bottom: 12px;
            align-items: flex-start;
        }

        .image-url-input {
            flex: 1;
            border: 1.5px solid var(--gray-mid);
            padding: 12px 14px;
            font-family: var(--font-body);
            font-size: 13px;
            color: var(--primary-dark);
            background: var(--white);
            border-radius: 6px;
            outline: none;
            transition: var(--transition);
        }

        .image-url-input:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);
        }

        .remove-image-url-btn {
            background: var(--error);
            color: white;
            border: none;
            padding: 12px 12px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 16px;
            transition: var(--transition);
        }

        .remove-image-url-btn:hover {
            background: rgba(239, 68, 68, 0.8);
        }

        .image-url-preview {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));
            gap: 12px;
            margin-top: 16px;
        }

        .preview-item {
            position: relative;
            border-radius: 8px;
            overflow: hidden;
            aspect-ratio: 1;
            background: #f0f0f0;
            border: 1px solid var(--gray-light);
        }

        .preview-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .preview-item.error {
            background: rgba(239, 68, 68, 0.1);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 32px;
        }

        @@keyframes fadeUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @@media (max-width: 600px) {
            .form-card { padding: 32px 24px; }
            .grid-2 { grid-template-columns: 1fr; gap: 0; }
            .image-url-input-group { flex-direction: column; }
            .remove-image-url-btn { width: 100%; }
        }
    </style>
}

<div class="form-page-container">
    <div class="form-card">
        <div class="form-header">
            <div class="icon-circle">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="32" height="32">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
            </div>
            <h1 class="form-title">Add New Product</h1>
        </div>

        <form asp-action="Create" method="post" id="productForm">
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

            <div class="form-group">
                <label asp-for="Name" class="form-label">Product Name</label>
                <input asp-for="Name" class="form-control" placeholder="e.g. Classic Leather Watch" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description" class="form-label">Description</label>
                <textarea asp-for="Description" class="form-control" rows="4" placeholder="Enter product details and specifications..."></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ImageUrl" class="form-label">Primary Image URL (Required)</label>
                <input asp-for="ImageUrl" class="form-control" placeholder="https://example.com/image.jpg" required />
                <span asp-validation-for="ImageUrl" class="text-danger"></span>
            </div>

            <!-- NEW: Additional Images Section -->
            <div class="image-urls-section">
                <span class="image-urls-title">📸 Additional Product Images (Optional)</span>
                <small style="color: #666; display: block; margin-bottom: 12px;">Add up to 5 additional product image URLs from the internet</small>
                
                <div id="imageUrlsContainer"></div>

                <button type="button" class="add-image-url-btn" id="addImageUrlBtn">+ Add Image URL</button>
                
                <div class="image-url-preview" id="imagePreview"></div>
            </div>

            <div class="grid-2">
                <div class="form-group">
                    <label asp-for="Price" class="form-label">Price ($)</label>
                    <input asp-for="Price" type="number" step="0.01" class="form-control" placeholder="0.00" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="StockQuantity" class="form-label">Stock Quantity</label>
                    <input asp-for="StockQuantity" type="number" class="form-control" placeholder="0" />
                    <span asp-validation-for="StockQuantity" class="text-danger"></span>
                </div>
            </div>

            <div class="grid-2">
                <div class="form-group">
                    <label asp-for="Discount" class="form-label">Discount (%)</label>
                    <input asp-for="Discount" type="number" step="0.01" class="form-control" placeholder="0" />
                    <span asp-validation-for="Discount" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="CategoryId" class="form-label">Category</label>
                    <select asp-for="CategoryId" class="form-control" asp-items="ViewBag.CategoriesList">
                        <option value="">-- Select a Category --</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group" style="display: flex; align-items: center; gap: 12px; margin-bottom: 24px;">
                <input type="checkbox" asp-for="IsFeatured" id="IsFeatured" style="width: 18px; height: 18px; cursor: pointer;" />
                <label asp-for="IsFeatured" class="form-label" style="margin-bottom: 0; cursor: pointer;">
                    Mark as Featured Product
                </label>
            </div>

            <!-- Hidden container for image URLs (for form submission) -->
            <div id="imageUrlsFormContainer"></div>

            <button type="submit" class="btn-submit">Save Product</button>
            <a asp-action="Index" class="back-link">Cancel & Back to Inventory</a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        const form = document.getElementById('productForm');
        const container = document.getElementById('imageUrlsContainer');
        const formContainer = document.getElementById('imageUrlsFormContainer');
        const previewContainer = document.getElementById('imagePreview');
        const addBtn = document.getElementById('addImageUrlBtn');
        let imageUrlCount = 0;

        addBtn.addEventListener('click', function (e) {
            e.preventDefault();

            if (imageUrlCount >= 5) {
                alert('Maximum 5 additional images allowed');
                return;
            }

            const inputGroup = document.createElement('div');
            inputGroup.className = 'image-url-input-group';
            inputGroup.innerHTML = `
                <input type="text" class="image-url-input" placeholder="https://example.com/image.jpg" oninput="updateImagePreview()" />
                <button type="button" class="remove-image-url-btn" onclick="removeImageUrl(this)">✕</button>
            `;

            container.appendChild(inputGroup);
            imageUrlCount++;
        });

        window.removeImageUrl = function (btn) {
            btn.closest('.image-url-input-group').remove();
            updateImagePreview();
        };

        window.updateImagePreview = function () {
            previewContainer.innerHTML = '';
            const inputs = container.querySelectorAll('.image-url-input');

            inputs.forEach((input) => {
                const url = input.value.trim();
                if (url) {
                    const previewDiv = document.createElement('div');
                    previewDiv.className = 'preview-item';

                    const img = document.createElement('img');
                    img.src = url;
                    img.onerror = function () {
                        previewDiv.classList.add('error');
                        previewDiv.textContent = '❌';
                        img.style.display = 'none';
                    };

                    previewDiv.appendChild(img);
                    previewContainer.appendChild(previewDiv);
                }
            });
        };

        form.addEventListener('submit', function () {
            formContainer.innerHTML = '';
            const inputs = container.querySelectorAll('.image-url-input');

            inputs.forEach((input) => {
                const url = input.value.trim();
                if (url) {
                    const hidden = document.createElement('input');
                    hidden.type = 'hidden';
                    hidden.name = 'productImageUrls';
                    hidden.value = url;
                    formContainer.appendChild(hidden);
                }
            });
        });
    </script>
}