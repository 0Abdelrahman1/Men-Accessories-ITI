@model Men_Accessories.Models.Product

@{
    ViewData["Title"] = "Edit Product";
    Layout = "~/Views/Shared/_ShopLayout.cshtml";
}

@section Styles {
    <style>
        .form-page-container {
            display: flex;
            justify-content: center;
            padding: 40px 20px 80px;
            width: 100%;
        }

        /* =========================================
           FORM CARD
        ========================================= */
        .form-card {
            background: var(--white);
            width: 100%;
            max-width: 760px;
            padding: 48px;
            border-radius: 16px;
            box-shadow: var(--shadow-md);
            border: 1px solid var(--gray-light);
            animation: fadeUp 0.5s ease both;
        }

        .form-header {
            margin-bottom: 40px;
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .icon-circle {
            width: 64px;
            height: 64px;
            background: rgba(245, 158, 11, 0.1); /* Warning/Orange tint for Edit */
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 16px;
            color: var(--warning);
        }

        .form-title {
            font-family: var(--font-display);
            font-size: 28px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--primary-dark);
            margin: 0;
        }

        /* =========================================
           INPUTS & LABELS
        ========================================= */
        .form-group {
            margin-bottom: 24px;
        }

        .form-label {
            display: block;
            font-family: var(--font-display);
            font-size: 13px;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: var(--primary-dark);
            margin-bottom: 8px;
        }

        .form-control {
            width: 100%;
            border: 1.5px solid var(--gray-mid);
            padding: 14px 16px;
            font-family: var(--font-body);
            font-size: 14px;
            color: var(--primary-dark);
            background: var(--gray-light);
            border-radius: 8px;
            outline: none;
            transition: var(--transition);
        }

        .form-control:focus {
            border-color: var(--accent);
            background: var(--white);
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);
        }

        .text-danger {
            font-size: 12px;
            color: var(--error);
            margin-top: 6px;
            display: block;
            font-weight: 600;
        }

        .validation-summary-errors {
            background: rgba(239, 68, 68, 0.1);
            padding: 16px;
            border-radius: 8px;
            margin-bottom: 24px;
            border-left: 4px solid var(--error);
        }
        
        .validation-summary-errors ul {
            list-style: none;
            margin: 0;
            padding: 0;
        }
        
        .validation-summary-errors li {
            font-size: 13px;
            color: var(--error);
            font-weight: 600;
        }

        /* =========================================
           LAYOUT & BUTTONS
        ========================================= */
        .grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        .btn-submit {
            width: 100%;
            background: var(--accent);
            color: var(--white);
            font-family: var(--font-display);
            font-size: 14px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            padding: 16px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            transition: var(--transition);
            margin-top: 16px;
        }

        .btn-submit:hover {
            background: var(--primary-dark);
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
        }

        .back-link {
            display: block;
            text-align: center;
            margin-top: 24px;
            font-family: var(--font-display);
            font-size: 12px;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--primary-text);
            text-decoration: none;
            font-weight: 600;
            transition: var(--transition);
        }

        .back-link:hover {
            color: var(--primary-dark);
        }

        @@keyframes fadeUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @@media (max-width: 600px) {
            .form-card { padding: 32px 24px; }
            .grid-2 { grid-template-columns: 1fr; gap: 0; }
        }
    </style>
}

<div class="form-page-container">
    <div class="form-card">
        <div class="form-header">
            <div class="icon-circle">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="32" height="32">
                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                </svg>
            </div>
            <h1 class="form-title">Edit Product</h1>
        </div>

        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
            
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CreatedAt" />

            <div class="form-group">
                <label asp-for="Name" class="form-label">Product Name</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description" class="form-label">Description</label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ImageUrl" class="form-label">Image URL</label>
                <input asp-for="ImageUrl" class="form-control" />
                <span asp-validation-for="ImageUrl" class="text-danger"></span>
            </div>

            <div class="grid-2">
                <div class="form-group">
                    <label asp-for="Price" class="form-label">Price ($)</label>
                    <input asp-for="Price" type="number" step="0.01" class="form-control" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="StockQuantity" class="form-label">Stock Quantity</label>
                    <input asp-for="StockQuantity" type="number" class="form-control" />
                    <span asp-validation-for="StockQuantity" class="text-danger"></span>
                </div>
            </div>

            <div class="grid-2">
                <div class="form-group">
                    <label asp-for="Discount" class="form-label">Discount (%)</label>
                    <input asp-for="Discount" type="number" step="0.01" class="form-control" />
                    <span asp-validation-for="Discount" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="CategoryId" class="form-label">Category ID</label>
                    <input asp-for="CategoryId" type="number" class="form-control" />
                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                </div>
            </div>

            <button type="submit" class="btn-submit">Update Product</button>
            <a asp-action="Index" class="back-link">Cancel & Back to Inventory</a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}