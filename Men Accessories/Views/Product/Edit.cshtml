@model Men_Accessories.Models.Product

@{
    ViewData["Title"] = "Edit Product";
    Layout = "~/Views/Shared/_ShopLayout.cshtml";
}

@section Styles {
    <style>
        .form-page-container {
            display: flex;
            justify-content: center;
            padding: 40px 20px 80px;
            width: 100%;
        }

        /* =========================================
           FORM CARD
        ========================================= */
        .form-card {
            background: var(--white);
            width: 100%;
            max-width: 760px;
            padding: 48px;
            border-radius: 16px;
            box-shadow: var(--shadow-md);
            border: 1px solid var(--gray-light);
            animation: fadeUp 0.5s ease both;
        }

        .form-header {
            margin-bottom: 40px;
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .icon-circle {
            width: 64px;
            height: 64px;
            background: rgba(245, 158, 11, 0.1); /* Warning/Orange tint for Edit */
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 16px;
            color: #F59E0B;
        }

        .form-title {
            font-family: var(--font-display);
            font-size: 28px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--primary-dark);
            margin: 0;
        }

        /* =========================================
           INPUTS & LABELS
        ========================================= */
        .form-group {
            margin-bottom: 24px;
        }

        .form-label {
            display: block;
            font-family: var(--font-display);
            font-size: 13px;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: var(--primary-dark);
            margin-bottom: 8px;
        }

        .form-control {
            width: 100%;
            border: 1.5px solid var(--gray-mid);
            padding: 14px 16px;
            font-family: var(--font-body);
            font-size: 14px;
            color: var(--primary-dark);
            background: var(--gray-light);
            border-radius: 8px;
            outline: none;
            transition: var(--transition);
        }

        .form-control:focus {
            border-color: var(--accent);
            background: var(--white);
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);
        }

        .text-danger {
            font-size: 12px;
            color: var(--error);
            margin-top: 6px;
            display: block;
            font-weight: 600;
        }

        .validation-summary-errors {
            background: rgba(239, 68, 68, 0.1);
            padding: 16px;
            border-radius: 8px;
            margin-bottom: 24px;
            border-left: 4px solid var(--error);
        }
        
        .validation-summary-errors ul {
            list-style: none;
            margin: 0;
            padding: 0;
        }
        
        .validation-summary-errors li {
            font-size: 13px;
            color: var(--error);
            font-weight: 600;
        }

        /* =========================================
           LAYOUT & BUTTONS
        ========================================= */
        .grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        .btn-submit {
            width: 100%;
            background: #F59E0B;
            color: var(--white);
            font-family: var(--font-display);
            font-size: 14px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            padding: 16px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            transition: var(--transition);
            margin-top: 16px;
        }

        .btn-submit:hover {
            background: var(--primary-dark);
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
        }

        .back-link {
            display: block;
            text-align: center;
            margin-top: 24px;
            font-family: var(--font-display);
            font-size: 12px;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--primary-text);
            text-decoration: none;
            font-weight: 600;
            transition: var(--transition);
        }

        .back-link:hover {
            color: var(--accent);
        }

        /* NEW: Image sections */
        .image-section {
            background: rgba(79, 70, 229, 0.05);
            border: 1px solid rgba(79, 70, 229, 0.2);
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 24px;
        }

        .image-section-title {
            font-family: var(--font-display);
            font-size: 12px;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--accent);
            font-weight: 700;
            margin-bottom: 16px;
            display: block;
        }

        .existing-images {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));
            gap: 12px;
            margin-bottom: 16px;
        }

        .image-item {
            position: relative;
            border-radius: 8px;
            overflow: hidden;
            aspect-ratio: 1;
            background: #f0f0f0;
            border: 2px solid var(--gray-light);
            transition: var(--transition);
        }

        .image-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .image-item:hover {
            border-color: var(--accent);
        }

        .delete-image-btn {
            position: absolute;
            top: 4px;
            right: 4px;
            background: rgba(239, 68, 68, 0.9);
            color: white;
            border: none;
            border-radius: 50%;
            width: 24px;
            height: 24px;
            cursor: pointer;
            font-size: 16px;
            padding: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            transition: opacity 0.2s;
        }

        .image-item:hover .delete-image-btn {
            opacity: 1;
        }

        .add-image-url-btn {
            background: var(--accent);
            color: white;
            border: none;
            padding: 10px 16px;
            border-radius: 6px;
            font-family: var(--font-display);
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            cursor: pointer;
            transition: var(--transition);
            margin-top: 12px;
        }

        .add-image-url-btn:hover {
            background: var(--primary-dark);
        }

        .image-url-input-group {
            display: flex;
            gap: 8px;
            margin-bottom: 12px;
            align-items: flex-start;
        }

        .image-url-input {
            flex: 1;
            border: 1.5px solid var(--gray-mid);
            padding: 12px 14px;
            font-family: var(--font-body);
            font-size: 13px;
            color: var(--primary-dark);
            background: var(--white);
            border-radius: 6px;
            outline: none;
            transition: var(--transition);
        }

        .image-url-input:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);
        }

        .remove-image-url-btn {
            background: var(--error);
            color: white;
            border: none;
            padding: 12px 12px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 16px;
            transition: var(--transition);
        }

        .remove-image-url-btn:hover {
            background: rgba(239, 68, 68, 0.8);
        }

        .image-url-preview {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));
            gap: 12px;
            margin-top: 16px;
        }

        .preview-item {
            position: relative;
            border-radius: 8px;
            overflow: hidden;
            aspect-ratio: 1;
            background: #f0f0f0;
            border: 1px solid var(--gray-light);
        }

        .preview-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .preview-item.error {
            background: rgba(239, 68, 68, 0.1);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 32px;
        }

        @@keyframes fadeUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @@media (max-width: 600px) {
            .form-card { padding: 32px 24px; }
            .grid-2 { grid-template-columns: 1fr; gap: 0; }
            .image-url-input-group { flex-direction: column; }
            .remove-image-url-btn { width: 100%; }
        }
    </style>
}

<div class="form-page-container">
    <div class="form-card">
        <div class="form-header">
            <div class="icon-circle">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="32" height="32">
                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                </svg>
            </div>
            <h1 class="form-title">Edit Product</h1>
        </div>

        <form asp-action="Edit" method="post" id="productForm">
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

            <input type="hidden" asp-for="Id" />

            <div class="form-group">
                <label asp-for="Name" class="form-label">Product Name</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description" class="form-label">Description</label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ImageUrl" class="form-label">Primary Image URL (Required)</label>
                <input asp-for="ImageUrl" class="form-control" required />
                <span asp-validation-for="ImageUrl" class="text-danger"></span>
            </div>

            <!-- NEW: Current Additional Images Display -->
            @if (Model.ProductImages != null && Model.ProductImages.Count > 0)
            {
                <div class="image-section">
                    <span class="image-section-title">📸 Current Additional Images</span>
                    <div class="existing-images" id="existingImagesContainer">
                        @foreach (var img in Model.ProductImages)
                        {
                            <div class="image-item">
                                <img src="@img.ImageUrl" alt="Product Image" onerror="this.style.display='none'" />
                                <form asp-action="DeleteProductImage" method="post" style="position: absolute; inset: 0; margin: 0;" onsubmit="return confirm('Delete this image?');">
                                    <input type="hidden" name="productImageId" value="@img.Id" />
                                    <button type="submit" class="delete-image-btn">✕</button>
                                </form>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- NEW: Add More Images Section -->
            <div class="image-section">
                <span class="image-section-title">➕ Add More Image URLs (Optional)</span>
                <small style="color: #666; display: block; margin-bottom: 12px;">Add up to 5 more images (max 5 total per product)</small>
                
                <div id="imageUrlsContainer"></div>

                <button type="button" class="add-image-url-btn" id="addImageUrlBtn">+ Add Image URL</button>
                
                <div class="image-url-preview" id="imagePreview"></div>
            </div>

            <div class="grid-2">
                <div class="form-group">
                    <label asp-for="Price" class="form-label">Price ($)</label>
                    <input asp-for="Price" type="number" step="0.01" class="form-control" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="StockQuantity" class="form-label">Stock Quantity</label>
                    <input asp-for="StockQuantity" type="number" class="form-control" />
                    <span asp-validation-for="StockQuantity" class="text-danger"></span>
                </div>
            </div>

            <div class="grid-2">
                <div class="form-group">
                    <label asp-for="Discount" class="form-label">Discount (%)</label>
                    <input asp-for="Discount" type="number" step="0.01" class="form-control" />
                    <span asp-validation-for="Discount" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="CategoryId" class="form-label">Category</label>
                    <select asp-for="CategoryId" class="form-control" asp-items="ViewBag.CategoriesList">
                        <option value="">-- Select a Category --</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group" style="display: flex; align-items: center; gap: 12px; margin-bottom: 24px;">
                <input type="checkbox" asp-for="IsFeatured" id="IsFeatured" style="width: 18px; height: 18px; cursor: pointer;" />
                <label asp-for="IsFeatured" class="form-label" style="margin-bottom: 0; cursor: pointer;">
                    Mark as Featured Product
                </label>
            </div>

            <!-- Hidden container for image URLs -->
            <div id="imageUrlsFormContainer"></div>

            <button type="submit" class="btn-submit">Save Changes</button>
            <a asp-action="Index" class="back-link">Cancel & Back to Inventory</a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        const form = document.getElementById('productForm');
        const container = document.getElementById('imageUrlsContainer');
        const formContainer = document.getElementById('imageUrlsFormContainer');
        const previewContainer = document.getElementById('imagePreview');
        const addBtn = document.getElementById('addImageUrlBtn');
        let imageUrlCount = 0;

        addBtn.addEventListener('click', function (e) {
            e.preventDefault();

            const existingCount = @(Model.ProductImages?.Count ?? 0);
            if (existingCount + imageUrlCount >= 5) {
                alert('Maximum 5 additional images allowed. Remove some existing images first.');
                return;
            }

            const inputGroup = document.createElement('div');
            inputGroup.className = 'image-url-input-group';
            inputGroup.innerHTML = `
                <input type="text" class="image-url-input" placeholder="https://example.com/image.jpg" oninput="updateImagePreview()" />
                <button type="button" class="remove-image-url-btn" onclick="removeImageUrl(this)">✕</button>
            `;

            container.appendChild(inputGroup);
            imageUrlCount++;
        });

        window.removeImageUrl = function (btn) {
            btn.closest('.image-url-input-group').remove();
            updateImagePreview();
        };

        window.updateImagePreview = function () {
            previewContainer.innerHTML = '';
            const inputs = container.querySelectorAll('.image-url-input');

            inputs.forEach((input) => {
                const url = input.value.trim();
                if (url) {
                    const previewDiv = document.createElement('div');
                    previewDiv.className = 'preview-item';

                    const img = document.createElement('img');
                    img.src = url;
                    img.onerror = function () {
                        previewDiv.classList.add('error');
                        previewDiv.textContent = '❌';
                        img.style.display = 'none';
                    };

                    previewDiv.appendChild(img);
                    previewContainer.appendChild(previewDiv);
                }
            });
        };

        form.addEventListener('submit', function () {
            formContainer.innerHTML = '';
            const inputs = container.querySelectorAll('.image-url-input');

            inputs.forEach((input) => {
                const url = input.value.trim();
                if (url) {
                    const hidden = document.createElement('input');
                    hidden.type = 'hidden';
                    hidden.name = 'productImageUrls';
                    hidden.value = url;
                    formContainer.appendChild(hidden);
                }
            });
        });
    </script>
}