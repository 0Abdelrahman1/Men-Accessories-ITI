@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        .admin-container {
            max-width: 1200px;
            margin: 0 auto;
            width: 100%;
            padding-bottom: 60px;
        }

        .admin-header {
            text-align: center;
            margin-bottom: 40px;
            padding: 40px 20px;
            background: var(--white);
            border-radius: 4px;
            border: 1px solid var(--gray-mid);
            animation: fadeUp .5s ease both;
        }

        .admin-title {
            font-family: var(--font-display);
            font-size: 32px;
            font-weight: 700;
            letter-spacing: 4px;
            text-transform: uppercase;
            color: var(--black);
        }

        .admin-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 30px;
            animation: fadeUp .6s ease both;
        }

        .admin-card {
            background: var(--white);
            border: 1px solid var(--gray-mid);
            padding: 40px 30px;
            text-align: center;
            transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

            .admin-card:hover {
                transform: translateY(-8px);
                box-shadow: 0 12px 30px rgba(0,0,0,.06);
                border-color: var(--accent);
            }

        .admin-icon {
            width: 70px;
            height: 70px;
            background: var(--gray-light);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 24px;
            color: var(--black);
            transition: color 0.3s, background 0.3s;
        }

        .admin-card:hover .admin-icon {
            background: var(--accent);
            color: var(--white);
        }

        .admin-icon svg {
            width: 32px;
            height: 32px;
        }

        .admin-card-title {
            font-family: var(--font-display);
            font-size: 18px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--black);
            margin-bottom: 12px;
        }

        .admin-card-desc {
            font-size: 14px;
            color: var(--gray-text);
            margin-bottom: 30px;
            line-height: 1.6;
        }

        .btn-admin {
            background: var(--black);
            color: var(--white);
            font-family: var(--font-display);
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            padding: 14px 28px;
            text-decoration: none;
            transition: background 0.3s;
            width: 100%;
        }

            .btn-admin:hover {
                background: var(--accent);
                color: var(--white);
            }
    </style>
}

<div class="admin-container">
    <div class="admin-header">
        <h1 class="admin-title">Control Panel</h1>
        <p style="color: var(--gray-text); margin-top: 10px; font-size: 15px;">Manage your store's inventory and orders efficiently.</p>
    </div>

    <div class="admin-grid">
        <div class="admin-card">
            <div class="admin-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>
            </div>
            <h3 class="admin-card-title">Products</h3>
            <p class="admin-card-desc">Add new accessories, update prices, or remove items.</p>
            <a asp-controller="Product" asp-action="Index" class="btn-admin">Manage Products</a>
        </div>

        <div class="admin-card">
            <div class="admin-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
            </div>
            <h3 class="admin-card-title">Categories</h3>
            <p class="admin-card-desc">Organize your store by creating or editing categories.</p>
            <a href="#" class="btn-admin">Manage Categories</a>
        </div>

        <div class="admin-card">
            <div class="admin-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
            </div>
            <h3 class="admin-card-title">Orders</h3>
            <p class="admin-card-desc">View customer orders and update their fulfillment status.</p>
            <a href="#" class="btn-admin">View Orders</a>
        </div>
    </div>
</div>